# VetCore Web imajı — Next.js standalone çıktısı.
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/domain/package.json packages/domain/
COPY packages/ui-tokens/package.json packages/ui-tokens/
COPY packages/config/package.json packages/config/
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web ./apps/web
COPY --from=deps /app/packages ./packages
COPY tsconfig.base.json turbo.json eslint.config.mjs ./
RUN pnpm --filter @vetcore/contracts... build && pnpm --filter @vetcore/web build

FROM node:22-alpine AS runtime
RUN addgroup -S vetcore && adduser -S vetcore -G vetcore
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=vetcore:vetcore /app/apps/web/.next/standalone ./
COPY --from=build --chown=vetcore:vetcore /app/apps/web/.next/static ./.next/static
COPY --from=build --chown=vetcore:vetcore /app/apps/web/public ./public
USER vetcore
EXPOSE 3000
CMD ["node", "server.js"]

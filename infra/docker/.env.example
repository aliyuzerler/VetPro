# VetCore — tek müşteri kurulum yapılandırması (Faz 15).
# Bu dosyayı .env olarak kopyalayın ve TÜM değerleri kurulum özelinde belirleyin.
# Zorunlu değişkenler boş bırakılırsa `docker compose up` bilinçli şekilde HATA verir
# (varsayılan parola/gizli anahtar ile kuruluma izin verilmez).

# --- PostgreSQL (zorunlu) ---
POSTGRES_USER=vetcore
POSTGRES_PASSWORD=
POSTGRES_DB=vetcore

# --- Uygulama sırları (zorunlu) ---
# Access token imza anahtarı (min 32 rastgele karakter; üretimde varsayılan reddedilir)
AUTH_JWT_SECRET=
# Yedek arşiv şifreleme anahtarı (Faz 14 — bkz. docs/RESTORE_RUNBOOK.md)
VETCORE_BACKUP_KEY=
# Yedek restore çift kapısı — üretimde açık bırakılmaz; restore tatbikatında true yapılır
VETCORE_BACKUP_ALLOW_RESTORE=false
# Kalıcı lisans aktivasyon imza anahtarı (satıcı sağlar; boşsa aktivasyon kapalı)
VETCORE_LICENSE_SIGNING_KEY=

# --- Nesne depolama (MinIO, zorunlu) ---
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=vetcore-files

# --- CORS / ters vekil ---
# Web arayüzünün servis edildiği köken(ler); virgülle ayrılır. Ör.: https://vetcore.klinik.example
VETCORE_CORS_ORIGINS=
CLINIC_TIMEZONE=Europe/Istanbul

# --- Hız sınırları (dakika başına; isteğe bağlı) ---
VETCORE_RATE_LIMIT_AUTH=20
VETCORE_RATE_LIMIT_API=600

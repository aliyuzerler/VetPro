# VetCore — ortam değişkenleri örneği
# Gerçek sırlar bu dosyaya yazılmaz; kurulum sırasında güvenli değerlerle değiştirilir.

# --- Uygulama ---
NODE_ENV=development
APP_NAME=VetCore
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Web → API proxy (Next.js rewrite hedefi) ---
API_PROXY_TARGET=http://127.0.0.1:4000

# --- API / Worker ---
PORT=4000
WORKER_PORT=4100
LOG_LEVEL=info

# --- Veritabanı ---
DATABASE_URL=postgresql://vetcore:change-me@localhost:5432/vetcore?schema=public

# --- Redis / kuyruk ---
REDIS_URL=redis://localhost:6379

# --- Nesne depolama (S3 uyumlu / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vetcore-private
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# --- Güvenlik (ilk sürümde kullanılacak; Faz 03'te devreye alınır) ---
JWT_ACCESS_SECRET=replace-with-strong-random-secret
JWT_REFRESH_SECRET=replace-with-strong-random-secret
ENCRYPTION_KEY=replace-with-managed-key

# --- Klinik yerelleştirme ---
CLINIC_TIMEZONE=Europe/Istanbul
DEFAULT_LOCALE=tr-TR

# --- Sağlayıcı adaptörleri (Faz 12'ye kadar devre dışı) ---
SMS_PROVIDER=disabled
EMAIL_PROVIDER=disabled
WHATSAPP_PROVIDER=disabled

# --- Faz 15 güvenlik ve lisans ---
# CORS izin listesi (virgülle ayrılmış kökenler; boş = aynı köken dışı reddedilir)
VETCORE_CORS_ORIGINS=
# Swagger UI (üretimde kapalı kalmalı)
VETCORE_ENABLE_SWAGGER=false
# Hız sınırları (dakika başına)
VETCORE_RATE_LIMIT_AUTH=20
VETCORE_RATE_LIMIT_API=600
# Kalıcı lisans aktivasyon imza anahtarı (satıcı sağlar; boşsa aktivasyon 503)
VETCORE_LICENSE_SIGNING_KEY=
# Yedek restore çift kapısı (üretimde false kalır; tatbikatta geçici true)
VETCORE_BACKUP_ALLOW_RESTORE=false

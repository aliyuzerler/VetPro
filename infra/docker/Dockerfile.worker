# VetCore Worker imajı — BullMQ işleyicileri.
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/worker/package.json apps/worker/
COPY packages/contracts/package.json packages/contracts/
COPY packages/domain/package.json packages/domain/
COPY packages/config/package.json packages/config/
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps ./apps
COPY --from=deps /app/packages ./packages
COPY tsconfig.base.json turbo.json eslint.config.mjs ./
RUN pnpm --filter @vetcore/contracts... build && pnpm --filter @vetcore/worker build

FROM node:22-alpine AS runtime
RUN addgroup -S vetcore && adduser -S vetcore -G vetcore
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=vetcore:vetcore /app/apps/worker/dist ./dist
COPY --from=build --chown=vetcore:vetcore /app/node_modules ./node_modules
USER vetcore
EXPOSE 4100
CMD ["node", "dist/main.js"]

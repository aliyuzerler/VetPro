// VetCore — Faz 06 şema.
// Kapsam: klinik/şube çekirdeği (Faz 01) + kimlik, personel, rol, izin, oturum ve denetim
// (Faz 03) + hasta sahibi, hasta, tür/ırk, uyarı, kilo gözlemi ve özel dosya varlıkları
// (Faz 04) + randevu takvimi, çalışma saatleri, bekleme listesi ve akış panosu (Faz 05)
// + muayene (SOAP), vital bulgular, tanı, ek dosya, addendum ve hizmet kataloğu (Faz 06).
// Stok, finans... ilgili fazlarda eklenir.
// Faz 06 politikası: imzalı muayene kaydı değişmez — düzeltmeler ClinicalAddendum ile
// yapılır ve denetim defterine yazılır. SOAP alanları Encounter üzerinde tutulur
// (tek aktif taslak + version alanı); ayrı SoapNote tablosu sürümleme gerekçesiyle
// eklenmedi. ServiceConsumptionRule.product_id Faz 07'de Product modeline FK olarak
// bağlanır (draft model: alan bu fazda yerinde, ilişki stok modülleriyle birlikte).
// Kurallar: UUID PK, UTC zaman damgaları, money/quantity için Decimal, silinmez defter ileriki fazlarda.
// Güvenlik: şifre yalnızca scrypt hash saklanır; refresh token yalnızca SHA-256 hash saklanır.
// Faz 04 politikası: sahip/hasta kayıtlarında fiziksel silme yok — arşivleme + açık merge
// (otomatik birleştirme yok); dosyalar private storage arkasında, indirme yetki kontrollüdür.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tek kurulum = tek müşteri klinik grubu (ADR-002). SaaS kiracılığı ilk sürümde yoktur;
/// ancak ileri geçiş için clinic kapsamı ilk günden taşınır (ADR-003).
model Clinic {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  legalName String?
  slug      String   @unique
  /// Klinik yerel saat dilimi; randevu ve tarih kuralları buradan okunur.
  timezone  String   @default("Europe/Istanbul")
  locale    String   @default("tr-TR")
  currency  String   @default("TRY")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches               Branch[]
  staff                  Staff[]
  roles                  Role[]
  auditEvents            AuditEvent[]
  owners                 Owner[]
  patients               Patient[]
  fileAssets             FileAsset[]
  appointmentTypes       AppointmentType[]
  scheduleBlocks         ScheduleBlock[]
  appointments           Appointment[]
  waitlistEntries        WaitlistEntry[]
  encounters             Encounter[]
  services               Service[]
  productCategories      ProductCategory[]
  products               Product[]
  suppliers              Supplier[]
  units                  Unit[]
  charges                Charge[]
  payments               Payment[]
  refunds                Refund[]
  cashRegisters          CashRegister[]
  cashSessions           CashSession[]
  cashMovements          CashMovement[]
  expenses               Expense[]
  supplierPayables       SupplierPayable[]
  prescriptions          Prescription[]
  vaccineProtocols       VaccineProtocol[]
  vaccineEvents          VaccineEvent[]
  vaccineReminders       VaccineReminder[]
  labCatalog             LabCatalog[]
  labOrders              LabOrder[]
  surgeryCases           SurgeryCase[]
  hospitalStays          HospitalStay[]
  notificationTemplates  NotificationTemplate[]
  notifications          Notification[]
  integrationConnections IntegrationConnection[]
  printDocuments         PrintDocument[]
  syncOperations         SyncOperation[]

  @@map("clinics")
}

/// Klinik altında çoklu şube desteği. Şubeye özel kayıtlar branch_id taşır.
model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  name      String
  /// Şube kodu; belge numaralandırma ve raporlarda kullanılır.
  code      String
  address   String?
  phone     String?
  email     String?
  isPrimary Boolean  @default(false) @map("is_primary")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  rooms            Room[]
  warehouses       Warehouse[]
  staffBranches    StaffBranch[]
  auditEvents      AuditEvent[]
  patients         Patient[]
  scheduleBlocks   ScheduleBlock[]
  appointments     Appointment[]
  waitlistEntries  WaitlistEntry[]
  encounters       Encounter[]
  serviceRecords   ServiceRecord[]
  charges          Charge[]
  servicePrices    ServicePrice[]
  stockMovements   StockMovement[]
  stockCounts      StockCount[]
  temperatureLogs  TemperatureLog[]
  payments         Payment[]
  refunds          Refund[]
  cashRegisters    CashRegister[]
  cashSessions     CashSession[]
  cashMovements    CashMovement[]
  expenses         Expense[]
  supplierPayables SupplierPayable[]
  prescriptions    Prescription[]
  vaccineEvents    VaccineEvent[]
  vaccineReminders VaccineReminder[]
  kennels          Kennel[]
  labOrders        LabOrder[]
  surgeryCases     SurgeryCase[]
  hospitalStays    HospitalStay[]
  notifications    Notification[]
  printDocuments   PrintDocument[]
  syncOperations   SyncOperation[]

  @@unique([clinicId, code])
  @@index([clinicId])
  @@map("branches")
}

/// Personel (kullanıcı) hesabı — klinik kapsamlı. Şubeye erişim StaffBranch ile verilir.
model Staff {
  id           String   @id @default(uuid()) @db.Uuid
  clinicId     String   @map("clinic_id") @db.Uuid
  email        String   @unique
  /// scrypt hash (N=16384, r=8, p=1) — düz metin asla saklanmaz.
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  /// Unvan: Veteriner Hekim, Resepsiyon, Stok Sorumlusu vb.
  title        String?
  phone        String?
  /// Pasif personel oturum açamaz; kayıt denetim için korunur.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  clinic                  Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  sessions                Session[]
  staffRoles              StaffRole[]
  staffBranches           StaffBranch[]
  auditEvents             AuditEvent[]
  patientAlerts           PatientAlert[]
  weightObservations      WeightObservation[]
  uploadedFiles           FileAsset[]
  scheduleBlocks          ScheduleBlock[]
  appointments            Appointment[]
  preferredWaitlist       WaitlistEntry[]            @relation("WaitlistPreferredStaff")
  overriddenAppointments  Appointment[]              @relation("AppointmentOverriddenBy")
  encounters              Encounter[]                @relation("EncounterVeterinarian")
  signedEncounters        Encounter[]                @relation("EncounterSignedBy")
  clinicalAddendums       ClinicalAddendum[]
  vitalObservations       VitalObservation[]
  serviceRecords          ServiceRecord[]
  reversedServiceRecords  ServiceRecord[]            @relation("ServiceRecordReverser")
  postedStockMovements    StockMovement[]            @relation("StockMovementPerformer")
  dispatchedTransfers     StockTransfer[]            @relation("StockTransferDispatcher")
  receivedTransfers       StockTransfer[]            @relation("StockTransferReceiver")
  completedStockCounts    StockCount[]               @relation("StockCountCompleter")
  temperatureLogs         TemperatureLog[]           @relation("TemperatureLogRecorder")
  createdPayments         Payment[]                  @relation("PaymentCreator")
  createdRefunds          Refund[]                   @relation("RefundCreator")
  openedCashSessions      CashSession[]              @relation("CashSessionOpener")
  closedCashSessions      CashSession[]              @relation("CashSessionCloser")
  createdCashMovements    CashMovement[]             @relation("CashMovementCreator")
  createdExpenses         Expense[]                  @relation("ExpenseCreator")
  createdPayables         SupplierPayable[]          @relation("SupplierPayableCreator")
  prescribedPrescriptions Prescription[]             @relation("PrescriptionVeterinarian")
  signedPrescriptions     Prescription[]             @relation("PrescriptionSignedBy")
  doseApprovedLines       PrescriptionLine[]         @relation("PrescriptionLineDoseApprover")
  dispenseEvents          DispenseEvent[]
  administrations         AdministrationEvent[]
  administeredVaccines    VaccineEvent[]
  sentVaccineReminders    VaccineReminder[]
  requestedLabOrders      LabOrder[]                 @relation("LabOrderRequester")
  vetLabOrders            LabOrder[]                 @relation("LabOrderVeterinarian")
  cancelledLabOrders      LabOrder[]                 @relation("LabOrderCanceller")
  collectedLabSamples     Sample[]                   @relation("SampleCollector")
  resultedLabResults      LabResult[]                @relation("LabResultReporter")
  acknowledgedLabResults  LabResult[]                @relation("LabResultAcknowledger")
  surgeryVetCases         SurgeryCase[]              @relation("SurgeryVeterinarian")
  anesthesiaDuties        AnesthesiaRecord[]         @relation("AnesthesiaAnesthetist")
  hospitalVetStays        HospitalStay[]             @relation("HospitalStayVeterinarian")
  hospitalObservations    HospitalObservation[]      @relation("HospitalObserver")
  administeredMeds        MedicationAdministration[] @relation("MedicationAdministerer")
  createdPrintDocuments   PrintDocument[]            @relation("PrintDocumentCreator")
  createdNotifications    Notification[]             @relation("NotificationCreator")
  syncOperations          SyncOperation[]

  @@index([clinicId])
  @@map("staff")
}

/// Rol — klinik kapsamlı ve düzenlenebilir; isSystem=true olanlar seed şablonudur
/// (şablon da düzenlenebilir, yalnızca "varsayılan" işaretini taşır).
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @map("clinic_id") @db.Uuid
  /// Stabil referans anahtarı: 'admin', 'veteriner', 'resepsiyon'...
  key         String
  name        String
  description String?
  /// Seed şablonu işareti (UI'da "Sistem şablonu" rozeti; yine düzenlenebilir).
  isSystem    Boolean  @default(false) @map("is_system")
  /// true ise rol tüm şubelere erişir (StaffBranch kontrolü atlanır).
  allBranches Boolean  @default(false) @map("all_branches")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  staffRoles      StaffRole[]

  @@unique([clinicId, key])
  @@index([clinicId])
  @@map("roles")
}

/// İzin kataloğu — global sabit liste (klinikten bağımsız), seed ile doldurulur.
model Permission {
  key         String  @id
  /// Grup: clinical | inventory | finance | reports | audit | settings | staff
  group       String
  name        String
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Rol ↔ izin eşlemesi (izin matrisi).
model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

/// Personel ↔ rol eşlemesi (çoklu rol desteği).
model StaffRole {
  staffId String @map("staff_id") @db.Uuid
  roleId  String @map("role_id") @db.Uuid

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([staffId, roleId])
  @@index([roleId])
  @@map("staff_roles")
}

/// Personel ↔ şube eşlemesi; aktif şube seçimi buradaki listeden yapılır.
model StaffBranch {
  staffId   String  @map("staff_id") @db.Uuid
  branchId  String  @map("branch_id") @db.Uuid
  isDefault Boolean @default(false) @map("is_default")

  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([staffId, branchId])
  @@index([branchId])
  @@map("staff_branches")
}

/// Oturum — refresh token rotasyonu kaydı. Refresh token yalnızca SHA-256 hash
/// saklanır; her refresh'te eski satır revoked edilir ve yenisi yazılır (rotasyon).
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  staffId          String    @map("staff_id") @db.Uuid
  /// Oturumun aktif şubesi; şube kapsamlı guard ve X-Branch-Id doğrulaması için.
  branchId         String?   @map("branch_id") @db.Uuid
  /// SHA-256(64 karakter hex) — düz refresh token asla saklanmaz.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?
  ip               String?
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  /// 'rotated' | 'logout' | 'reuse-detected' | 'expired'
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("sessions")
}

/// Silinmez denetim defteri — yetki değişiklikleri dahil tüm kritik işlemler.
model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  clinicId   String   @map("clinic_id") @db.Uuid
  /// İşlemi yapan personel; null = sistem.
  staffId    String?  @map("staff_id") @db.Uuid
  /// İşlemin gerçekleştiği şube; şube silinirse kayıt korunur (SetNull).
  branchId   String?  @db.Uuid
  /// Nokta notasyonu: 'auth.login', 'role.permissions.update', 'staff.create'...
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  /// Değişiklik özeti (before/after); PII ve sır içermemeli.
  metadata   Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  clinic Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  staff  Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([staffId])
  @@map("audit_events")
}

/// Muayene/operasyon odası — şube kapsamlı master kayıt (Faz 03 placeholder).
model Room {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String
  /// 'examination' | 'surgery' | 'lab' | 'other'
  kind      String   @default("examination")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  surgeryCases SurgeryCase[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("rooms")
}

/// Depo — şube kapsamlı master kayıt (placeholder; stok hareketleri Faz 07'de).
model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  lots              InventoryLot[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  outgoingTransfers StockTransfer[]  @relation("TransferFromWarehouse")
  incomingTransfers StockTransfer[]  @relation("TransferToWarehouse")
  stockCounts       StockCount[]
  temperatureLogs   TemperatureLog[]
  dispenseEvents    DispenseEvent[]
  vaccineEvents     VaccineEvent[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("warehouses")
}

/// Tür kataloğu — global sabit liste (klinikten bağımsız), seed ile doldurulur.
/// Anahtarlar stabil: 'cat', 'dog', 'bird'... API ve raporlar anahtarla konuşur.
model Species {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  breeds   Breed[]
  patients Patient[]

  vaccineProtocols VaccineProtocol[]
  labCatalog       LabCatalog[]

  @@map("species")
}

/// Irk — türe bağlı master kayıt. Klinik özel ırk ekleme master.manage izniyle serbest.
model Breed {
  id        String   @id @default(uuid()) @db.Uuid
  speciesId String   @map("species_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  species  Species   @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  patients Patient[]

  @@unique([speciesId, name])
  @@index([speciesId])
  @@map("breeds")
}

/// Hasta sahibi — klinik kapsamlı (şubeler arası görünür; hasta kaydı şube kapsamlıdır).
/// Silme yok: arşiv (archivedAt) + açık merge (mergedIntoOwnerId; otomatik birleştirme yok).
model Owner {
  id                String    @id @default(uuid()) @db.Uuid
  clinicId          String    @map("clinic_id") @db.Uuid
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  /// TC kimlik no — opsiyonel; KVKK kapsamında en az gerek ilkesiyle toplanır.
  identityNo        String?   @map("identity_no")
  address           String?
  notes             String?
  /// Doluysa kayıt arşivlenmiş sayılır; listelerde varsayılan gizli.
  archivedAt        DateTime? @map("archived_at")
  archivedReason    String?   @map("archived_reason")
  /// Bu kayıt başka sahibe birleştirildiyse hedefin kimliği (kaynak taraf).
  mergedIntoOwnerId String?   @map("merged_into_owner_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  clinic          Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  mergedIntoOwner Owner?          @relation("OwnerMerge", fields: [mergedIntoOwnerId], references: [id], onDelete: SetNull)
  mergedOwners    Owner[]         @relation("OwnerMerge")
  contacts        OwnerContact[]
  consents        OwnerConsent[]
  patients        Patient[]
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  encounters      Encounter[]
  charges         Charge[]
  payments        Payment[]
  refunds         Refund[]
  surgeryCases    SurgeryCase[]
  hospitalStays   HospitalStay[]
  notifications   Notification[]
  printDocuments  PrintDocument[]

  @@index([clinicId])
  @@index([clinicId, lastName, firstName])
  @@map("owners")
}

/// Sahip iletişim kanalı — telefon/e-posta; arama normalize alan üzerinden yapılır.
/// Telefon normalizasyonu: yalnızca rakamlar, TR ülke koduyla (905xxxxxxxxx).
model OwnerContact {
  id         String   @id @default(uuid()) @db.Uuid
  ownerId    String   @map("owner_id") @db.Uuid
  /// 'phone' | 'email'
  kind       String
  value      String
  /// Normalize arama değeri: telefon → rakamlar (90..., TR), e-posta → küçük harf.
  normalized String
  /// 'Cep', 'İş', 'Ev'...
  label      String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([normalized])
  @@map("owner_contacts")
}

/// Sahip rızaları — KVKK ve iletişim tercihleri. Son durum tek satırda tutulur.
model OwnerConsent {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  /// 'kvkk' | 'sms' | 'email' | 'whatsapp' | 'marketing'
  kind      String
  granted   Boolean   @default(false)
  grantedAt DateTime? @map("granted_at")
  revokedAt DateTime? @map("revoked_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, kind])
  @@map("owner_consents")
}

/// Hasta (hayvan) kaydı — şube kapsamlı: kayıt şubesine erişimi olmayan personel
/// listelerde görmez ve doğrudan erişimde 403 alır. Kod klinik içinde tekildir.
model Patient {
  id                  String    @id @default(uuid()) @db.Uuid
  clinicId            String    @map("clinic_id") @db.Uuid
  branchId            String    @map("branch_id") @db.Uuid
  ownerId             String    @map("owner_id") @db.Uuid
  speciesId           String    @map("species_id") @db.Uuid
  breedId             String?   @map("breed_id") @db.Uuid
  name                String
  /// Klinik içinde tekil insan tarafından okunur kod (HP-0001...).
  code                String
  /// Mikroçip numarası — normalize (rakamlar/büyük harf), klinik içinde tekil.
  microchip           String?
  /// 'female' | 'male' | 'unknown'
  gender              String    @default("unknown")
  birthDate           DateTime? @map("birth_date") @db.Date
  neutered            Boolean   @default(false)
  color               String?
  bloodType           String?   @map("blood_type")
  archivedAt          DateTime? @map("archived_at")
  archivedReason      String?   @map("archived_reason")
  mergedIntoPatientId String?   @map("merged_into_patient_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  clinic                    Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch                    Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  owner                     Owner                      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  species                   Species                    @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  breed                     Breed?                     @relation(fields: [breedId], references: [id], onDelete: SetNull)
  mergedIntoPatient         Patient?                   @relation("PatientMerge", fields: [mergedIntoPatientId], references: [id], onDelete: SetNull)
  mergedPatients            Patient[]                  @relation("PatientMerge")
  alerts                    PatientAlert[]
  weights                   WeightObservation[]
  files                     FileAsset[]
  appointments              Appointment[]
  waitlistEntries           WaitlistEntry[]
  encounters                Encounter[]
  vitals                    VitalObservation[]
  charges                   Charge[]
  prescriptions             Prescription[]
  administrationEvents      AdministrationEvent[]
  vaccineEvents             VaccineEvent[]
  vaccineReminders          VaccineReminder[]
  labOrders                 LabOrder[]
  surgeryCases              SurgeryCase[]
  hospitalStays             HospitalStay[]
  medicationAdministrations MedicationAdministration[]
  printDocuments            PrintDocument[]

  @@unique([clinicId, code])
  @@unique([clinicId, microchip])
  @@index([clinicId])
  @@index([branchId])
  @@index([ownerId])
  @@index([clinicId, name])
  @@map("patients")
}

/// Hasta uyarısı — alerji, kronik hastalık veya kritik not. Aktif uyarılar listede
/// ve detayda görünür (kabul kriteri); çözülünce geçmişe düşer.
model PatientAlert {
  id               String    @id @default(uuid()) @db.Uuid
  patientId        String    @map("patient_id") @db.Uuid
  /// 'allergy' | 'chronic' | 'warning'
  kind             String
  label            String
  /// 'low' | 'medium' | 'high'
  severity         String    @default("medium")
  active           Boolean   @default(true)
  createdByStaffId String?   @map("created_by_staff_id") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  patient        Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdByStaff Staff?  @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([patientId, active])
  @@map("patient_alerts")
}

/// Kilo gözlemi — ilaç doz hesabı ve eğilim için geçmiş saklanır (yalnızca son değer değil).
model WeightObservation {
  id               String   @id @default(uuid()) @db.Uuid
  patientId        String   @map("patient_id") @db.Uuid
  weightKg         Decimal  @map("weight_kg") @db.Decimal(6, 3)
  measuredAt       DateTime @map("measured_at")
  note             String?
  createdByStaffId String?  @map("created_by_staff_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  patient        Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdByStaff Staff?  @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([patientId, measuredAt])
  @@map("weight_observations")
}

/// Hasta dosyası — private storage adapter arkasında tutulur; storage_key dışarı sızmaz.
/// İndirme yalnızca yetki + şube kapsamı doğrulayan API ucuyla akar (public URL yok).
model FileAsset {
  id                String   @id @default(uuid()) @db.Uuid
  clinicId          String   @map("clinic_id") @db.Uuid
  patientId         String   @map("patient_id") @db.Uuid
  uploadedByStaffId String?  @map("uploaded_by_staff_id") @db.Uuid
  /// Orijinal dosya adı (yalnızca görüntüleme; saklamada UUID anahtar kullanılır).
  fileName          String   @map("file_name")
  storageKey        String   @map("storage_key")
  mimeType          String   @map("mime_type")
  sizeBytes         Int      @map("size_bytes")
  /// 'document' | 'image' | 'lab-result' | 'other'
  kind              String   @default("document")
  createdAt         DateTime @default(now()) @map("created_at")

  clinic              Clinic               @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy          Staff?               @relation(fields: [uploadedByStaffId], references: [id], onDelete: SetNull)
  clinicalAttachments ClinicalAttachment[]

  @@index([patientId])
  @@index([clinicId])
  @@map("file_assets")
}

/// Randevu türü — klinik kapsamlı katalog (Faz 05). Süre takvim formunda son saat
/// önerisi için, renk anahtarı takvim/pano rozetleri için kullanılır.
model AppointmentType {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @map("clinic_id") @db.Uuid
  name        String
  /// Varsayılan süre (dakika)
  durationMin Int      @map("duration_min")
  /// Takvim rengi anahtarı (design tokens): brand | green | amber | red | violet | cyan
  colorKey    String   @default("brand") @map("color_key")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  clinic          Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]

  @@unique([clinicId, name])
  @@index([clinicId])
  @@map("appointment_types")
}

/// Çalışma saatleri ve plan engelleri (Faz 05). staffId null → şube düzeyi varsayılan;
/// personelin kendi 'working' bloğu varsa şube varsayılanı yerine geçer.
/// kind='working' randevu kabul aralığı; kind='blocked' tam engel — override edilmez.
model ScheduleBlock {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  /// null = şube genelinde; dolu = yalnız bu personelin saatleri
  staffId   String?  @map("staff_id") @db.Uuid
  /// 'working' | 'blocked'
  kind      String
  /// Haftanın günü — JS Date.getDay() uyumu: 0=Pazar ... 6=Cumartesi
  weekday   Int
  /// Klinik yerel saat diliminde gün içi dakika (09:00 = 540)
  startMin  Int      @map("start_min")
  endMin    Int      @map("end_min")
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff  Staff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([branchId, weekday, kind])
  @@index([staffId, weekday, kind])
  @@map("schedule_blocks")
}

/// Randevu — şube kapsamlı (Faz 05). Aralıklar UTC instants olarak saklanır;
/// gün/hafta/ay sınırları ve çalışma saatleri klinik saat diliminde (Clinic.timezone,
/// varsayılan Europe/Istanbul — sabit UTC+03) hesaplanır. Durum makinesi ileri yönlüdür:
/// scheduled → arrived → waiting → in_consultation → completed; her aktif aşamadan
/// cancelled/no_show çıkışı mümkündür. Fiziksel silme yok (geçmiş bütünlüğü).
model Appointment {
  id                  String    @id @default(uuid()) @db.Uuid
  clinicId            String    @map("clinic_id") @db.Uuid
  branchId            String    @map("branch_id") @db.Uuid
  patientId           String    @map("patient_id") @db.Uuid
  ownerId             String    @map("owner_id") @db.Uuid
  appointmentTypeId   String    @map("appointment_type_id") @db.Uuid
  /// Atanan hekim — çakışma kontrolü ve çalışma saati politikası bu kayıttan okunur
  staffId             String    @map("staff_id") @db.Uuid
  roomId              String?   @map("room_id") @db.Uuid
  scheduledStart      DateTime  @map("scheduled_start")
  scheduledEnd        DateTime  @map("scheduled_end")
  /// 'scheduled' | 'arrived' | 'waiting' | 'in_consultation' | 'completed' |
  /// 'no_show' | 'cancelled'
  status              String    @default("scheduled")
  notes               String?
  cancelledReason     String?   @map("cancelled_reason")
  checkedInAt         DateTime? @map("checked_in_at")
  waitingAt           DateTime? @map("waiting_at")
  inConsultationAt    DateTime? @map("in_consultation_at")
  completedAt         DateTime? @map("completed_at")
  /// no_show / cancelled anı — pano süre hesapları ve raporlar için
  closedAt            DateTime? @map("closed_at")
  /// Çalışma saatleri dışı onay kaydı: yetkili personel + zorunlu sebep (denetlenir)
  overrideReason      String?   @map("override_reason")
  overriddenByStaffId String?   @map("overridden_by_staff_id") @db.Uuid
  createdById         String?   @map("created_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  clinic          Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  owner           Owner           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  type            AppointmentType @relation(fields: [appointmentTypeId], references: [id], onDelete: Restrict)
  staff           Staff           @relation(fields: [staffId], references: [id], onDelete: Restrict)
  room            Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  overriddenBy    Staff?          @relation("AppointmentOverriddenBy", fields: [overriddenByStaffId], references: [id], onDelete: SetNull)
  waitlistEntries WaitlistEntry[] @relation("WaitlistBookedAppointment")
  encounters      Encounter[]

  @@index([clinicId, scheduledStart])
  @@index([branchId, scheduledStart])
  @@index([staffId, scheduledStart])
  @@index([roomId, scheduledStart])
  @@index([patientId])
  @@index([status, scheduledStart])
  @@map("appointments")
}

/// Bekleme listesi kaydı — uygun slot yoksa hasta kuyruğu (Faz 05). "Randevuya çevir"
/// akışı buradan randevu üretir; giriş sonra 'scheduled' olarak işaretlenir.
model WaitlistEntry {
  id                  String    @id @default(uuid()) @db.Uuid
  clinicId            String    @map("clinic_id") @db.Uuid
  branchId            String    @map("branch_id") @db.Uuid
  patientId           String    @map("patient_id") @db.Uuid
  ownerId             String    @map("owner_id") @db.Uuid
  appointmentTypeId   String?   @map("appointment_type_id") @db.Uuid
  preferredStaffId    String?   @map("preferred_staff_id") @db.Uuid
  /// Tercih edilen gün — klinik yerel takvim günü (UTC gece yarısı @db.Date)
  preferredDate       DateTime? @map("preferred_date") @db.Date
  preferredStartMin   Int?      @map("preferred_start_min")
  preferredEndMin     Int?      @map("preferred_end_min")
  note                String?
  /// 'waiting' | 'scheduled' | 'cancelled'
  status              String    @default("waiting")
  bookedAppointmentId String?   @map("booked_appointment_id") @db.Uuid
  createdById         String?   @map("created_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  clinic            Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  owner             Owner            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  type              AppointmentType? @relation(fields: [appointmentTypeId], references: [id], onDelete: SetNull)
  preferredStaff    Staff?           @relation("WaitlistPreferredStaff", fields: [preferredStaffId], references: [id], onDelete: SetNull)
  bookedAppointment Appointment?     @relation("WaitlistBookedAppointment", fields: [bookedAppointmentId], references: [id], onDelete: SetNull)

  @@index([branchId, status])
  @@index([patientId])
  @@index([ownerId])
  @@map("waitlist_entries")
}

/// Muayene kaydı — şube kapsamlı (Faz 06). SOAP alanları kayıt üzerinde tutulur;
/// durum makinesi ileri yönlüdür: draft → in_progress → signed → closed
/// (draft/in_progress → voided). İmzalı kayıt değiştirilemez ve silinemez;
/// düzeltmeler ClinicalAddendum ile yapılır (kabul kriteri: signed encounter
/// doğrudan update/delete edilememeli). Fiziksel silme yalnızca draft'ta mümkündür
/// (taslakta geçmiş denetim değeri yoktur); voided kayıtlar geçmiş için korunur.
model Encounter {
  id             String    @id @default(uuid()) @db.Uuid
  clinicId       String    @map("clinic_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  ownerId        String    @map("owner_id") @db.Uuid
  /// Muayeneyi yürüten hekim; yalnızca encounter.manage izni olan personel atanabilir.
  veterinarianId String    @map("veterinarian_id") @db.Uuid
  appointmentId  String?   @map("appointment_id") @db.Uuid
  /// 'draft' | 'in_progress' | 'signed' | 'closed' | 'voided'
  status         String    @default("draft")
  chiefComplaint String?   @map("chief_complaint")
  /// SOAP — Subjective (anamnez/sahip beyanı)
  subjective     String?
  /// SOAP — Objective (klinik bulgu)
  objective      String?
  /// SOAP — Assessment (tanı değerlendirmesi)
  assessment     String?
  /// SOAP — Plan (tedavi planı)
  plan           String?
  notes          String?
  startedAt      DateTime  @default(now()) @map("started_at")
  signedAt       DateTime? @map("signed_at")
  signedById     String?   @map("signed_by_id") @db.Uuid
  closedAt       DateTime? @map("closed_at")
  voidedAt       DateTime? @map("voided_at")
  /// Kayıt sürümü — her yazma işleminde +1; imzada kilitlenir.
  version        Int       @default(1)
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  owner        Owner        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  veterinarian Staff        @relation("EncounterVeterinarian", fields: [veterinarianId], references: [id], onDelete: Restrict)
  signedBy     Staff?       @relation("EncounterSignedBy", fields: [signedById], references: [id], onDelete: SetNull)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  vitals         VitalObservation[]
  diagnoses      Diagnosis[]
  attachments    ClinicalAttachment[]
  addendums      ClinicalAddendum[]
  serviceRecords ServiceRecord[]
  charges        Charge[]
  prescriptions  Prescription[]
  labOrders      LabOrder[]
  surgeryCases   SurgeryCase[]
  hospitalStays  HospitalStay[]
  printDocuments PrintDocument[]

  @@index([branchId, status, startedAt])
  @@index([patientId, startedAt])
  @@index([branchId, startedAt])
  @@index([veterinarianId, startedAt])
  @@map("encounters")
}

/// Vital bulgu gözlemi — aynı bulgunun (kind) geçmiş ölçümleri korunur
/// (kabul kriteri: yalnızca son değer değil, tüm ölçüm geçmişi). kind kataloğu:
/// 'temp' | 'weight' | 'heart_rate' | 'resp_rate' | 'cap refill' | 'blood_pressure'
/// | 'glucose' | 'pain_score' | 'other'.
model VitalObservation {
  id               String   @id @default(uuid()) @db.Uuid
  patientId        String   @map("patient_id") @db.Uuid
  encounterId      String?  @map("encounter_id") @db.Uuid
  /// Bulgu kataloğu anahtarı (yukarıdaki liste)
  kind             String
  value            Decimal  @db.Decimal(10, 3)
  /// Birim: °C, kg, atım/dk, /dk, mmHg, mg/dL...
  unit             String
  measuredAt       DateTime @map("measured_at")
  note             String?
  createdByStaffId String?  @map("created_by_staff_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  createdBy Staff?     @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([patientId, kind, measuredAt])
  @@index([encounterId])
  @@map("vital_observations")
}

/// Tanı — muayeneye bağlı; imzadan sonra eklenemez (kayıt kilitlidir).
model Diagnosis {
  id          String   @id @default(uuid()) @db.Uuid
  encounterId String   @map("encounter_id") @db.Uuid
  /// Sistem kategorisi kodu (klinik sözlüğü; serbest metin de kabul edilir)
  code        String?
  name        String
  /// 'primary' | 'secondary' | 'differential'
  kind        String   @default("primary")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("diagnoses")
}

/// Muayene eki — hastaya ait mevcut dosya varlığını muayeneye bağlar
/// (yükleme Faz 04 dosya ucundan; erişim private storage + yetki kontrolü arkasında).
model ClinicalAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  encounterId String   @map("encounter_id") @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  label       String?
  createdAt   DateTime @default(now()) @map("created_at")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  asset     FileAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([encounterId, assetId])
  @@index([encounterId])
  @@map("clinical_attachments")
}

/// İmzalı kayıt düzeltmesi — orijinal muayeneye referans verir; kayıt değişmez
/// (kabul kriteri: addendum orijinal kaydı referanslamalı ve denetim üretmeli).
/// Yazar, zaman ve şube denetim amaçlı saklanır (clinical-record-integrity kuralı).
model ClinicalAddendum {
  id            String   @id @default(uuid()) @db.Uuid
  encounterId   String   @map("encounter_id") @db.Uuid
  authorStaffId String   @map("author_staff_id") @db.Uuid
  body          String
  createdAt     DateTime @default(now()) @map("created_at")

  /// Cascade: addendum yalnız signed/closed kayıtta var olabilir; encounter fiziksel
  /// silme yalnız draft'ta mümkündür — bu ilişkide Restrict'e ihtiyaç yoktur.
  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  author    Staff     @relation(fields: [authorStaffId], references: [id], onDelete: Restrict)

  @@index([encounterId, createdAt])
  @@map("clinical_addendums")
}

/// Hizmet kataloğu — klinik kapsamlı (Faz 06). Süre takvim/randevu önerisinde,
/// kategori gruplamada, tüketim kuralı Faz 08 stok bağlantısında kullanılır.
model Service {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @map("clinic_id") @db.Uuid
  /// Klinik içinde tekil insan tarafından okunur kod (HIZ-...).
  code        String
  name        String
  /// Kategori: muayene | cerrahi | laboratuvar | aşılama | görüntüleme | diş | bakım | diğer
  category    String   @default("muayene")
  /// Varsayılan süre (dakika)
  durationMin Int      @map("duration_min")
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  clinic                    Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  prices                    ServicePrice[]
  consumptionRules          ServiceConsumptionRule[]
  recordLines               ServiceRecordLine[]
  medicationAdministrations MedicationAdministration[]

  @@unique([clinicId, code])
  @@index([clinicId, active])
  @@map("services")
}

/// Hizmet fiyatı — geçerlilik tarihli, şube override'lı fiyat satırları.
/// Çözümleme: (branchId eşit > null) ve (valid_from <= now < valid_to) arasından
/// en yeni valid_from kazananır (kabul kriteri: fiyat geçerlilik tarihleri ve
/// şube override doğru çözülmeli). Fiyat satırları geçmiş için korunur.
model ServicePrice {
  id        String    @id @default(uuid()) @db.Uuid
  serviceId String    @map("service_id") @db.Uuid
  /// null = tüm şubeler için genel fiyat; dolu = yalnız o şubede override
  branchId  String?   @map("branch_id") @db.Uuid
  currency  String    @default("TRY")
  amount    Decimal   @db.Decimal(10, 2)
  taxCode   String?   @map("tax_code")
  validFrom DateTime  @map("valid_from")
  /// null = süresiz geçerli
  validTo   DateTime? @map("valid_to")
  createdAt DateTime  @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([serviceId, validFrom])
  @@index([branchId])
  @@map("service_prices")
}

/// Hizmet tüketim kuralı — hizmetin varsayılan ürün tüketimi (Faz 08'te stok
/// hareketine dönüşür). product_id FK'sı Faz 07'de Product modeliyle eklenir;
/// bu fazda alan yerinde, ilişki kurulmadan draft olarak tanımlanır.
model ServiceConsumptionRule {
  id               String   @id @default(uuid()) @db.Uuid
  serviceId        String   @map("service_id") @db.Uuid
  /// Faz 07'de Product FK'sı eklenecek (draft alan)
  productId        String?  @map("product_id") @db.Uuid
  defaultQty       Decimal  @map("default_qty") @db.Decimal(10, 3)
  /// Birim etiketi (Faz 07'de Unit modeline bağlanır)
  unit             String?
  /// true ise tüketim zorunlu (hizmet kapatılırken eksikse uyarır)
  required         Boolean  @default(false)
  /// Tahsis politikası: 'fifo' | 'nearest_expiry' | 'manual' (Faz 08'te okunur)
  allocationPolicy String   @default("fifo") @map("allocation_policy")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  service Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// Faz 07: Product FK'sı bağlandı — ürün arşivlenirse kural korunur (productId null'a düşer)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([serviceId])
  @@map("service_consumption_rules")
}

/// Hizmet kaydı — muayeneyi seçilen hizmetler (Faz 06'da yalnızca taslak
/// fiyatlama; Faz 08'te stok+finans atomik post'u bağlanır).
model ServiceRecord {
  id                 String    @id @default(uuid()) @db.Uuid
  clinicId           String    @map("clinic_id") @db.Uuid
  encounterId        String    @map("encounter_id") @db.Uuid
  branchId           String    @map("branch_id") @db.Uuid
  /// 'draft' | 'finalized' — finalized gerçek stok/finans post'unu tetikler (Faz 08)
  status             String    @default("draft")
  performedByStaffId String?   @map("performed_by_staff_id") @db.Uuid
  finalizedAt        DateTime? @map("finalized_at")
  /// Faz 08 atomik işlemi için idempotency anahtarı (mobil tekrar denemeleri)
  idempotencyKey     String?   @map("idempotency_key") @db.Uuid
  /// Faz 08 reversal — orijinal hareketler asla silinmez; ters hareket + ücret
  /// düzeltme satırı yazılır, kayıt burada işaretlenir (append-only ilkesi).
  reversedAt         DateTime? @map("reversed_at")
  reversedByStaffId  String?   @map("reversed_by_staff_id") @db.Uuid
  createdById        String?   @map("created_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  encounter   Encounter           @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  performedBy Staff?              @relation(fields: [performedByStaffId], references: [id], onDelete: SetNull)
  reversedBy  Staff?              @relation("ServiceRecordReverser", fields: [reversedByStaffId], references: [id], onDelete: SetNull)
  lines       ServiceRecordLine[]
  charge      Charge?

  @@unique([idempotencyKey])
  @@index([encounterId])
  @@index([branchId, status])
  @@map("service_records")
}

/// Ücret — kesinleşen hizmet kaydının sahipe yansıyan borcu (Faz 08).
/// Hizmet finalize işlemiyle aynı transaction'da doğar; reversal negatif
/// düzeltme satırı ekler, toplam sıfıra inerse void olur. Ödeme bağlantıları
/// Faz 09'da PaymentAllocation ile eklenir.
model Charge {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @map("clinic_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  encounterId     String?  @map("encounter_id") @db.Uuid
  serviceRecordId String?  @map("service_record_id") @db.Uuid
  ownerId         String   @map("owner_id") @db.Uuid
  patientId       String?  @map("patient_id") @db.Uuid
  /// 'open' | 'void' — Faz 09'a ödeme/alacak durumları eklenecek
  status          String   @default("open")
  currency        String   @default("TRY")
  total           Decimal  @db.Decimal(12, 2)
  note            String?
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  clinic        Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  encounter     Encounter?          @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  serviceRecord ServiceRecord?      @relation(fields: [serviceRecordId], references: [id], onDelete: SetNull)
  owner         Owner               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  patient       Patient?            @relation(fields: [patientId], references: [id], onDelete: SetNull)
  lines         ChargeLine[]
  allocations   PaymentAllocation[]

  @@unique([serviceRecordId])
  @@index([clinicId, status])
  @@index([ownerId])
  @@index([branchId, createdAt])
  @@map("charges")
}

/// Ücret satırı — append-only. sourceType 'service' (hizmet satırı) veya
/// 'service_reversal' (negatif düzeltme); qty işaretlidir, reversal satırları
/// negatif yazılır ve orijinal satırlar asla silinmez.
model ChargeLine {
  id          String   @id @default(uuid()) @db.Uuid
  chargeId    String   @map("charge_id") @db.Uuid
  /// 'service' | 'service_reversal'
  sourceType  String   @map("source_type")
  /// ServiceRecordLine.id (service) veya ServiceRecord.id (reversal)
  sourceId    String   @map("source_id") @db.Uuid
  description String
  qty         Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  taxAmount   Decimal  @map("tax_amount") @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  charge Charge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([chargeId])
  @@index([sourceType, sourceId])
  @@map("charge_lines")
}

/// Hizmet kaydı satırı — fiyat çözümleme anında dondurulur (unit_price geçmiş
/// fiyat satırından kopyalanır; sonradan fiyat değişimi kaydı etkilemez).
model ServiceRecordLine {
  id              String  @id @default(uuid()) @db.Uuid
  serviceRecordId String  @map("service_record_id") @db.Uuid
  serviceId       String  @map("service_id") @db.Uuid
  qty             Decimal @db.Decimal(10, 3)
  unitPrice       Decimal @map("unit_price") @db.Decimal(10, 2)
  discount        Decimal @default(0) @db.Decimal(10, 2)
  tax             Decimal @default(0) @db.Decimal(10, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(12, 2)

  serviceRecord ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([serviceRecordId])
  @@map("service_record_lines")
}

// ─── Faz 07 — Ürün, depo, lot, tedarikçi ve stok defteri ───────────────────

/// Ürün kategorisi — klinik kapsamlı master kayıt (İlaç, Aşı, Sarf...).
model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  clinic   Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([clinicId, name])
  @@index([clinicId])
  @@map("product_categories")
}

/// Ölçü birimi — klinik kapsamlı master kayıt (adet, ml, mg, kutu...).
/// Stabil anahtarlar seed ile kurulur; dönüşümler ProductUnitConversion'dadır.
model Unit {
  id       String @id @default(uuid()) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  key      String
  name     String

  clinic          Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  baseProducts    Product[]               @relation("ProductBaseUnit")
  conversionsFrom ProductUnitConversion[] @relation("ConversionFromUnit")
  conversionsTo   ProductUnitConversion[] @relation("ConversionToUnit")

  @@unique([clinicId, key])
  @@map("units")
}

/// Ürün kartı — klinik kapsamlı. SKU klinik içinde tekil; barkod opsiyonel.
/// trackingType 'lot' ise tüm çıkışlar parti üzerinden yürür (FEFO önerili,
/// expired/quarantine varsayılan bloklu); 'none' ise depo bazlı toplanır.
model Product {
  id               String   @id @default(uuid()) @db.Uuid
  clinicId         String   @map("clinic_id") @db.Uuid
  categoryId       String?  @map("category_id") @db.Uuid
  /// İnsan tarafından okunur klinik tekil kod (SKU, ÜRN-...).
  code             String
  barcode          String?
  name             String
  /// 'lot' | 'none'
  trackingType     String   @default("lot") @map("tracking_type")
  baseUnitId       String   @map("base_unit_id") @db.Uuid
  /// Minimum stok eşiği (baz birim) — düşük stok uyarısı için
  minStock         Decimal  @default(0) @map("min_stock") @db.Decimal(12, 3)
  /// Referans satış fiyatı (Faz 09 ücretlendirmede öneri olarak okunur)
  defaultSalePrice Decimal? @map("default_sale_price") @db.Decimal(10, 2)
  notes            String?
  /// Arşiv: fiziksel silme yok — lot/hareket/defter bütünlüğü Restrict ile korunur
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  clinic                    Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  category                  ProductCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  baseUnit                  Unit                       @relation("ProductBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  conversions               ProductUnitConversion[]
  lots                      InventoryLot[]
  movementLines             StockMovementLine[]
  balances                  StockBalance[]
  transferLines             StockTransferLine[]
  countLines                StockCountLine[]
  consumptionRules          ServiceConsumptionRule[]
  prescriptionLines         PrescriptionLine[]
  medicationAdministrations MedicationAdministration[]
  dispenseEvents            DispenseEvent[]
  administrationEvents      AdministrationEvent[]
  vaccineProtocols          VaccineProtocol[]
  vaccineEvents             VaccineEvent[]
  vaccineReminders          VaccineReminder[]

  @@unique([clinicId, code])
  @@index([clinicId, active])
  @@index([clinicId, barcode])
  @@map("products")
}

/// Ürün birim dönüşümü — 1 fromUnit = factor × toUnit (ör. 1 kutu = 10 adet).
model ProductUnitConversion {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  fromUnitId String  @map("from_unit_id") @db.Uuid
  toUnitId   String  @map("to_unit_id") @db.Uuid
  factor     Decimal @db.Decimal(12, 6)

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromUnit Unit    @relation("ConversionFromUnit", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnit   Unit    @relation("ConversionToUnit", fields: [toUnitId], references: [id], onDelete: Restrict)

  @@unique([productId, fromUnitId, toUnitId])
  @@index([productId])
  @@map("product_unit_conversions")
}

/// Tedarikçi — klinik kapsamlı master kayıt. Mal kabul ve iade hareketlerinde
/// referans alınır; lotlara SetNull ile bağlanır (tedarikçi arşivlenirse lot korunur).
model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  name      String
  taxNumber String?  @map("tax_number")
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic    Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  lots      InventoryLot[]
  movements StockMovement[]
  payables  SupplierPayable[]
  expenses  Expense[]

  @@unique([clinicId, name])
  @@index([clinicId, active])
  @@map("suppliers")
}

/// Stok partisi (lot) — lot takipli ürünlerin depo bazlı fiziksel parti kaydı.
/// Aynı (ürün, depo, parti kodu) tekildir; aynı kod farklı son kullanma/maliyet ile
/// gelirse LOT_CONFLICT ile reddedilir (mal kabul birleştirme kuralı: kod+skt+maliyet
/// aynıysa mevcut partiye eklenir). status: 'active' | 'quarantined'.
model InventoryLot {
  id          String    @id @default(uuid()) @db.Uuid
  clinicId    String    @map("clinic_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  lotCode     String    @map("lot_code")
  /// Son kullanma tarihi (gün sonu) — null = tarihsiz parti
  expiresAt   DateTime? @map("expires_at")
  /// Mal kabul birim maliyeti — defter hareketlerine kopyalanır
  unitCost    Decimal   @default(0) @map("unit_cost") @db.Decimal(10, 2)
  status      String    @default("active")
  supplierId  String?   @map("supplier_id") @db.Uuid
  receivedAt  DateTime  @default(now()) @map("received_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplier         Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  balances         StockBalance[]
  movementLines    StockMovementLine[]
  transferSources  StockTransferLine[] @relation("TransferSourceLot")
  transferReceipts StockTransferLine[] @relation("TransferReceivedLot")
  countLines       StockCountLine[]
  dispenseEvents   DispenseEvent[]
  vaccineEvents    VaccineEvent[]

  @@unique([productId, warehouseId, lotCode])
  @@index([productId, warehouseId, status])
  @@index([warehouseId, expiresAt])
  @@map("inventory_lots")
}

/// Stok hareket defteri — APPEND-ONLY. Update/delete veritabanı tetikleyicileriyle
/// bloklanır; düzeltme yalnızca telafi hareketiyle (adjustment/reversal) yapılır.
/// kind: 'goods_receipt' | 'consumption' | 'adjustment' | 'transfer_out' |
/// 'transfer_in' | 'supplier_return'. refType/refId ile StockTransfer/StockCount
/// kaynağına işaret edilir. idempotencyKey mobil tekrar denemelerini tekilleştirir.
model StockMovement {
  id                 String   @id @default(uuid()) @db.Uuid
  clinicId           String   @map("clinic_id") @db.Uuid
  branchId           String   @map("branch_id") @db.Uuid
  warehouseId        String   @map("warehouse_id") @db.Uuid
  kind               String
  status             String   @default("posted")
  supplierId         String?  @map("supplier_id") @db.Uuid
  refType            String?  @map("ref_type")
  refId              String?  @map("ref_id") @db.Uuid
  /// Sayım farkı gerekçesi ve manuel düzeltme zorunlu gerekçe burada taşınır
  reason             String?
  note               String?
  performedByStaffId String?  @map("performed_by_staff_id") @db.Uuid
  idempotencyKey     String?  @map("idempotency_key") @db.Uuid
  postedAt           DateTime @default(now()) @map("posted_at")
  createdAt          DateTime @default(now()) @map("created_at")

  warehouse                 Warehouse                  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  branch                    Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier                  Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  performedBy               Staff?                     @relation("StockMovementPerformer", fields: [performedByStaffId], references: [id], onDelete: SetNull)
  medicationAdministrations MedicationAdministration[] @relation("MedicationStockMovement")
  lines                     StockMovementLine[]

  @@unique([idempotencyKey])
  @@index([clinicId, kind, postedAt])
  @@index([warehouseId, postedAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

/// Defter satırı — append-only. qty işaretlidir: giriş +, çıkış −, düzeltme ±.
model StockMovementLine {
  id         String  @id @default(uuid()) @db.Uuid
  movementId String  @map("movement_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  /// null = partisiz ürün (trackingType 'none')
  lotId      String? @map("lot_id") @db.Uuid
  qty        Decimal @db.Decimal(12, 3)
  unitCost   Decimal @default(0) @map("unit_cost") @db.Decimal(10, 2)

  movement StockMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot      InventoryLot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([movementId])
  @@index([productId, lotId])
  @@map("stock_movement_lines")
}

/// Stok bakiyesi projeksiyonu — defterden türetilir, aynı işlemde güncellenir.
/// Mutlak bakiye yazımı yok: yalnızca atomik artır/azalt (güvenli tüketim).
/// lotId null = partisiz ürün. Mutabakat: SUM(defter satırları) == qtyOnHand.
model StockBalance {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @map("clinic_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  lotId       String?  @map("lot_id") @db.Uuid
  qtyOnHand   Decimal  @map("qty_on_hand") @db.Decimal(12, 3)
  updatedAt   DateTime @updatedAt @map("updated_at")

  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lot       InventoryLot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId, lotId])
  @@index([warehouseId, productId])
  @@map("stock_balances")
}

/// Depolar arası transfer — iki aşamalı: dispatch (kaynak düşer, yolda) →
/// receive (hedef depoda yeni parti oluşur, stok artar). draft iptal edilebilir.
/// Yoldaki miktar = dispatched transfer satırları (ayrı sanal depo yoktur).
model StockTransfer {
  id                  String    @id @default(uuid()) @db.Uuid
  clinicId            String    @map("clinic_id") @db.Uuid
  code                String
  fromBranchId        String    @map("from_branch_id") @db.Uuid
  toBranchId          String    @map("to_branch_id") @db.Uuid
  fromWarehouseId     String    @map("from_warehouse_id") @db.Uuid
  toWarehouseId       String    @map("to_warehouse_id") @db.Uuid
  /// 'draft' | 'dispatched' | 'received' | 'cancelled'
  status              String    @default("draft")
  note                String?
  dispatchedAt        DateTime? @map("dispatched_at")
  dispatchedByStaffId String?   @map("dispatched_by_staff_id") @db.Uuid
  receivedAt          DateTime? @map("received_at")
  receivedByStaffId   String?   @map("received_by_staff_id") @db.Uuid
  createdById         String?   @map("created_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  fromWarehouse Warehouse           @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse           @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  dispatchedBy  Staff?              @relation("StockTransferDispatcher", fields: [dispatchedByStaffId], references: [id], onDelete: SetNull)
  receivedBy    Staff?              @relation("StockTransferReceiver", fields: [receivedByStaffId], references: [id], onDelete: SetNull)
  lines         StockTransferLine[]

  @@unique([clinicId, code])
  @@index([clinicId, status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@map("stock_transfers")
}

/// Transfer satırı — lot takipli üründe kaynak parti zorunlu; receive sonrası
/// hedef depoda açılan parti receivedLotId'ye yazılır (izlenebilirlik).
model StockTransferLine {
  id            String  @id @default(uuid()) @db.Uuid
  transferId    String  @map("transfer_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  lotId         String? @map("lot_id") @db.Uuid
  qty           Decimal @db.Decimal(12, 3)
  receivedLotId String? @map("received_lot_id") @db.Uuid

  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot         InventoryLot? @relation("TransferSourceLot", fields: [lotId], references: [id], onDelete: Restrict)
  receivedLot InventoryLot? @relation("TransferReceivedLot", fields: [receivedLotId], references: [id], onDelete: SetNull)

  @@index([transferId])
  @@map("stock_transfer_lines")
}

/// Stok sayımı — depo bazlı sayım föyü. Taslakta satırlar güncellenebilir;
/// 'complete' tamamlanırken farklar için gerekçe (reason) zorunludur ve her fark
/// satırı için 'adjustment' hareketi + denetim kaydı üretilir.
model StockCount {
  id                 String    @id @default(uuid()) @db.Uuid
  clinicId           String    @map("clinic_id") @db.Uuid
  code               String
  branchId           String    @map("branch_id") @db.Uuid
  warehouseId        String    @map("warehouse_id") @db.Uuid
  /// 'draft' | 'completed' | 'cancelled'
  status             String    @default("draft")
  note               String?
  completedAt        DateTime? @map("completed_at")
  completedByStaffId String?   @map("completed_by_staff_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  completedBy Staff?           @relation("StockCountCompleter", fields: [completedByStaffId], references: [id], onDelete: SetNull)
  lines       StockCountLine[]

  @@unique([clinicId, code])
  @@index([clinicId, status])
  @@index([warehouseId])
  @@map("stock_counts")
}

/// Sayım satırı — beklenen bakiye sayım açılışında dondurulur; fark = counted − expected.
model StockCountLine {
  id           String   @id @default(uuid()) @db.Uuid
  stockCountId String   @map("stock_count_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  lotId        String?  @map("lot_id") @db.Uuid
  expectedQty  Decimal  @map("expected_qty") @db.Decimal(12, 3)
  countedQty   Decimal? @map("counted_qty") @db.Decimal(12, 3)

  stockCount StockCount    @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot        InventoryLot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, productId, lotId])
  @@index([stockCountId])
  @@map("stock_count_lines")
}

/// Soğuk zincir / depo sıcaklık kaydı — depo bazlı ölçüm defteri (append-only
/// kullanım amaçlanır; düzenleme uçları sunulmaz).
model TemperatureLog {
  id                String   @id @default(uuid()) @db.Uuid
  clinicId          String   @map("clinic_id") @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  celsius           Decimal  @db.Decimal(5, 2)
  measuredAt        DateTime @map("measured_at")
  note              String?
  recordedByStaffId String?  @map("recorded_by_staff_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  warehouse  Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  recordedBy Staff?    @relation("TemperatureLogRecorder", fields: [recordedByStaffId], references: [id], onDelete: SetNull)

  @@index([warehouseId, measuredAt])
  @@map("temperature_logs")
}

// ─── Faz 09 — Kasa, tahsilat, cari hesap ve giderler ───────────────────────
// Politika: tüm finansal yazımlar append-only defter mantığındadır — tahsilat,
// iade, kasa hareketi ve ücret satırı fiziksel olarak silinmez; düzeltme ters
// kayıtla yapılır. Money alanları Decimal(12,2) (kuruş kaymasız). Tahsilat
// idempotencyKey ile korunur (mobil retry REPLAY döner). İade orijinal
// tahsilata bağlıdır ve denetim defterine yazılır. Kasa oturumu kapanışında
// fark hesaplanır; fark ≠ 0 ise açıklama zorunludur.

/// Tahsilat — hasta sahibinden alınan ödeme. Kısmi ödeme desteklenir:
/// tutarın ücretlere dağılan kısmı PaymentAllocation ile, kalanı ise sahibin
/// ileri kredisi olarak cari hesapta izlenir.
model Payment {
  id             String   @id @default(uuid()) @db.Uuid
  clinicId       String   @map("clinic_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  ownerId        String   @map("owner_id") @db.Uuid
  /// 'cash' | 'card' | 'transfer' | 'other'
  method         String
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("TRY")
  /// İstemci üretimi idempotency anahtarı — aynı anahtar REPLAY döner.
  idempotencyKey String?  @map("idempotency_key")
  /// Nakit tahsilat açık kasa oturumuna bağlanır; kart/havale için opsiyonel.
  cashSessionId  String?  @map("cash_session_id") @db.Uuid
  note           String?
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  clinic      Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  owner       Owner               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  cashSession CashSession?        @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  createdBy   Staff?              @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]
  refunds     Refund[]

  /// NULLS NOT DISTINCT değil: NULL anahtarlar (elle tahsilat) çok olabilir.
  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, ownerId, createdAt])
  @@index([branchId, createdAt])
  @@index([cashSessionId])
  @@map("payments")
}

/// Tahsilat dağıtımı — tahsilatın ücretler üzerine paylaştırılması.
/// Dağıtım toplamı tutarı aşamaz ve ücret bakiyesini geçemez (servis kilidi);
/// kayıt append-only: iade, dağıtımı silmez (cari ekstremde ayrı satırdır).
model PaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  chargeId  String   @map("charge_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  charge  Charge  @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@unique([paymentId, chargeId])
  @@index([chargeId])
  @@map("payment_allocations")
}

/// İade — orijinal tahsilata bağlı append-only kayıt. İade toplamı tahsilat
/// tutarını aşamaz (kalan iade edilebilir tutar servisçe hesaplanır);
/// REFUND_CREATED denetim yazımı zorunludur (kabul kriteri).
model Refund {
  id            String   @id @default(uuid()) @db.Uuid
  clinicId      String   @map("clinic_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  paymentId     String   @map("payment_id") @db.Uuid
  ownerId       String   @map("owner_id") @db.Uuid
  /// Orijinal yöntemle uyumlu önerilir: 'cash' | 'card' | 'transfer' | 'other'
  method        String
  amount        Decimal  @db.Decimal(12, 2)
  reason        String
  /// Nakit iade açık kasa oturumuna bağlanır (kasadan çıkış hareketi).
  cashSessionId String?  @map("cash_session_id") @db.Uuid
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  owner       Owner        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  createdBy   Staff?       @relation("RefundCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clinicId, ownerId, createdAt])
  @@index([paymentId])
  @@index([cashSessionId])
  @@map("refunds")
}

/// Kasa — şubeye bağlı fiziksel çekmece/POS tanımı. Kasa başına aynı anda tek
/// açık oturum (migration'da kısmi tekil indeksle garanti edilir).
model CashRegister {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic   Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch   Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sessions CashSession[]

  @@unique([clinicId, branchId, name])
  @@index([clinicId, branchId, active])
  @@map("cash_registers")
}

/// Kasa oturumu — açılış bakiyesi ile açılır, sayım ile kapanır.
/// expected = openingFloat + toplam giriş − toplam çıkış; fark = counted −
/// expected. Fark ≠ 0 ise differenceNote zorunludur (kabul kriteri).
model CashSession {
  id             String    @id @default(uuid()) @db.Uuid
  clinicId       String    @map("clinic_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  registerId     String    @map("register_id") @db.Uuid
  /// 'open' | 'closed'
  status         String    @default("open")
  openingFloat   Decimal   @map("opening_float") @db.Decimal(12, 2)
  countedTotal   Decimal?  @map("counted_total") @db.Decimal(12, 2)
  expectedTotal  Decimal?  @map("expected_total") @db.Decimal(12, 2)
  difference     Decimal?  @db.Decimal(12, 2)
  /// Fark ≠ 0 ise zorunlu; fark = 0 için boş bırakılabilir.
  differenceNote String?   @map("difference_note") @db.Text
  openedById     String    @map("opened_by_id") @db.Uuid
  closedById     String?   @map("closed_by_id") @db.Uuid
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")

  clinic    Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  register  CashRegister   @relation(fields: [registerId], references: [id], onDelete: Restrict)
  openedBy  Staff          @relation("CashSessionOpener", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy  Staff?         @relation("CashSessionCloser", fields: [closedById], references: [id], onDelete: SetNull)
  payments  Payment[]
  movements CashMovement[]
  refunds   Refund[]
  expenses  Expense[]

  @@index([registerId, status])
  @@index([clinicId, branchId, openedAt])
  @@map("cash_sessions")
}

/// Kasa hareket defteri — append-only. sourceType: 'payment' | 'refund' |
/// 'expense' | 'manual_in' | 'manual_out'. direction: 'in' | 'out'.
/// Oturum kapanınca yeni hareket yazılamaz (servis kilidi).
model CashMovement {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @map("clinic_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  direction   String
  amount      Decimal  @db.Decimal(12, 2)
  sourceType  String   @map("source_type")
  sourceId    String?  @map("source_id") @db.Uuid
  reason      String?
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  session   CashSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  createdBy Staff?      @relation("CashMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  clinic    Clinic      @relation(fields: [clinicId], references: [id])
  branch    Branch      @relation(fields: [branchId], references: [id])

  @@index([sessionId, createdAt])
  @@index([clinicId, sourceType, sourceId])
  @@map("cash_movements")
}

/// Gider — klinik operasyonel gideri. Nakit gider açık oturuma bağlanır ve
/// kasadan çıkış hareketi üretir; kart/havale gideri oturumsuz kaydedilir.
model Expense {
  id            String   @id @default(uuid()) @db.Uuid
  clinicId      String   @map("clinic_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  /// 'medication' | 'equipment' | 'rent' | 'salary' | 'utility' | 'marketing' | 'maintenance' | 'other'
  category      String
  /// 'cash' | 'card' | 'transfer' | 'other'
  method        String
  amount        Decimal  @db.Decimal(12, 2)
  vendorId      String?  @map("vendor_id") @db.Uuid
  description   String
  spentAt       DateTime @map("spent_at")
  cashSessionId String?  @map("cash_session_id") @db.Uuid
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  vendor      Supplier?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  createdBy   Staff?       @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clinicId, branchId, spentAt])
  @@index([category])
  @@index([cashSessionId])
  @@map("expenses")
}

/// Tedarikçi borcu — elle açılır veya mal kabulden türetilir. Kısmi ödeme
/// paidAmount ile izlenir; paidAmount ≥ amount iken status 'settled' olur.
/// Kapatma denetim yazımı üretir; kayıt silinmez, hatalı kayıt 'void' olur.
model SupplierPayable {
  id          String    @id @default(uuid()) @db.Uuid
  clinicId    String    @map("clinic_id") @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  supplierId  String    @map("supplier_id") @db.Uuid
  /// Tedarikçi fatura/borç belge numarası
  documentNo  String?   @map("document_no")
  description String?
  amount      Decimal   @db.Decimal(12, 2)
  paidAmount  Decimal   @default(0) @map("paid_amount") @db.Decimal(12, 2)
  /// 'open' | 'settled' | 'void'
  status      String    @default("open")
  dueDate     DateTime? @map("due_date")
  settledAt   DateTime? @map("settled_at")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy Staff?   @relation("SupplierPayableCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clinicId, supplierId, status])
  @@index([branchId, status])
  @@map("supplier_payables")
}

// ─── Faz 10 — Reçete, ilaç uygulaması, aşı ve takip ─────────────────────────
// Politikalar:
// - Reçete yalnızca prescription.sign izni olan veteriner tarafından imzalanır;
//   imzalı reçete değişmez (satır eklenemez, void edilemez).
// - Doz yardımcısı yalnızca aritmetik ÖNERİ üretir: formül ve birimler görünür
//   tutulur, satıra işlenen öneri veterinerin açık onayı (doseApproved) olmadan
//   imzalamayı bloklar — hiçbir doz önerisi otomatik kesinleşmez.
// - Prescribed (PrescriptionLine) / dispensed (DispenseEvent) / administered
//   (AdministrationEvent) kayıtları ayrı tablolarda tutulur: ne yazıldığı,
//   depodan ne çıktığı ve hastaya ne uygulandığı birbirinden bağımsız izlenir.
// - Aşı kaydı lot + son kullanma tarihini kayıt anında dondurur; süresi geçmiş
//   veya karantinalı partiden aşı uygulanamaz.
// - Aşı takvimi klinik protokolüyle (VaccineProtocol) yapılandırılır; sabit
//   evrensel takvim yoktur. Hatırlatma aynı aşı kaydı için tür bazında tekildir.

/// Reçete — muayeneye bağlı, yetkili veteriner imzalı ilaç listesi.
/// status: 'draft' | 'signed' | 'voided'. İmzada klinik içinde tekil code
/// (REC-0001) atanır. Mevzuat alanları (officialRef) yapılandırılabilir;
/// sabit e-reçete iddiası yoktur (sağlayıcı adaptörü ileri faz).
model Prescription {
  id             String    @id @default(uuid()) @db.Uuid
  clinicId       String    @map("clinic_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  encounterId    String?   @map("encounter_id") @db.Uuid
  /// Reçeteyi yazan veteriner; imza ayrıca prescription.sign izni ister
  veterinarianId String    @map("veterinarian_id") @db.Uuid
  /// İmzada atanan klinik tekil reçete numarası (REC-0001)
  code           String?
  /// 'draft' | 'signed' | 'voided'
  status         String    @default("draft")
  notes          String?
  /// Resmi mevzuat alanı (e-reçete no, seri...) — zorunlu değil, yapılandırılabilir
  officialRef    String?   @map("official_ref")
  signedAt       DateTime? @map("signed_at")
  signedById     String?   @map("signed_by_id") @db.Uuid
  /// void yalnızca taslakta; imzalı reçete değişmez
  voidedAt       DateTime? @map("voided_at")
  voidedReason   String?   @map("voided_reason")
  version        Int       @default(1)
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  clinic       Clinic     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient      Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  veterinarian Staff      @relation("PrescriptionVeterinarian", fields: [veterinarianId], references: [id], onDelete: Restrict)
  signedBy     Staff?     @relation("PrescriptionSignedBy", fields: [signedById], references: [id], onDelete: SetNull)

  lines          PrescriptionLine[]
  dispenses      DispenseEvent[]
  printDocuments PrintDocument[]

  @@unique([clinicId, code])
  @@index([clinicId, status])
  @@index([branchId, status])
  @@index([patientId, createdAt])
  @@index([encounterId])
  @@map("prescriptions")
}

/// Reçete satırı — PRESCRIBED kayıt. Ürün katalogdan seçilebilir ya da serbest
/// adla yazılabilir. Doz yardımcısı alanları (doseCalc*) yalnızca öneriyi ve
/// formülü taşır; doseApproved=false iken imza bloklanır (kabul kriteri 2).
model PrescriptionLine {
  id             String   @id @default(uuid()) @db.Uuid
  prescriptionId String   @map("prescription_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  /// Katalog dışı ilaç yazımına izin: serbest ilaç adı zorunlu
  drugName       String   @map("drug_name")
  /// Uygulama formu: 'tablet' | 'sirup' | 'enjeksiyon' | 'merhem' | 'damla' | 'diger'
  form           String
  /// Yazılan doz — miktar + birim (mg, ml, IU...); doz yardımcısından veya elle
  doseAmount     Decimal? @map("dose_amount") @db.Decimal(10, 3)
  doseUnit       String?  @map("dose_unit")
  /// Uygulama yolu: 'oral' | 'deri_alti' | 'kas_ici' | 'damar_ici' | 'topikal' | 'diger'
  route          String
  /// Sıklık serbest metin (ör. 'günde 2 kez')
  frequency      String
  durationDays   Int?     @map("duration_days")
  /// Verilen miktar + birim (ambalaj/şişe/adet — dağıtım stok üzerinden yapılır)
  quantity       Decimal  @db.Decimal(12, 3)
  quantityUnit   String   @map("quantity_unit")
  instructions   String?

  // Doz yardımcısı — aritmetik öneri ve görünür formül; onay bilgisi
  doseCalcWeightKg      Decimal?  @map("dose_calc_weight_kg") @db.Decimal(8, 3)
  doseCalcMgPerKg       Decimal?  @map("dose_calc_mg_per_kg") @db.Decimal(10, 3)
  /// Görünür formül metni (ör. '20 kg × 10 mg/kg')
  doseCalcFormula       String?   @map("dose_calc_formula")
  doseCalcSuggested     Decimal?  @map("dose_calc_suggested") @db.Decimal(10, 3)
  doseCalcUnit          String?   @map("dose_calc_unit")
  /// Veteriner açık onayı — yalnızca prescription.sign izniyle true yapılabilir
  doseApproved          Boolean   @default(false) @map("dose_approved")
  doseApprovedByStaffId String?   @map("dose_approved_by_staff_id") @db.Uuid
  doseApprovedAt        DateTime? @map("dose_approved_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  doseApprovedBy Staff?       @relation("PrescriptionLineDoseApprover", fields: [doseApprovedByStaffId], references: [id], onDelete: SetNull)

  dispenses            DispenseEvent[]
  administrationEvents AdministrationEvent[]

  @@index([prescriptionId])
  @@index([productId])
  @@map("prescription_lines")
}

/// Reçete dağıtım (sevk) kaydı — DISPENSED. Depodan çıkan gerçek miktarı tutar;
/// stok defterine aynı işlemde 'consumption' hareketi yazar (refType
/// 'DispenseEvent'). Parti seçimi açık lot ya da FEFO; expired/karantina bloklu.
/// lotCode/expiresAt kayıt anında partiden dondurulur (izlenebilirlik).
model DispenseEvent {
  id                 String    @id @default(uuid()) @db.Uuid
  clinicId           String    @map("clinic_id") @db.Uuid
  branchId           String    @map("branch_id") @db.Uuid
  prescriptionId     String    @map("prescription_id") @db.Uuid
  prescriptionLineId String    @map("prescription_line_id") @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  warehouseId        String    @map("warehouse_id") @db.Uuid
  lotId              String?   @map("lot_id") @db.Uuid
  lotCode            String?   @map("lot_code")
  expiresAt          DateTime? @map("expires_at")
  qty                Decimal   @db.Decimal(12, 3)
  /// Yazılan stok defteri hareketi — mutabakat izlenebilirliği
  movementId         String?   @map("movement_id") @db.Uuid
  dispensedByStaffId String    @map("dispensed_by_staff_id") @db.Uuid
  dispensedAt        DateTime  @default(now()) @map("dispensed_at")
  note               String?
  /// Mobil tekrar denemelerinde tekilleştirme
  idempotencyKey     String?   @map("idempotency_key") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")

  prescription     Prescription     @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  prescriptionLine PrescriptionLine @relation(fields: [prescriptionLineId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse        Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lot              InventoryLot?    @relation(fields: [lotId], references: [id], onDelete: SetNull)
  dispensedBy      Staff            @relation(fields: [dispensedByStaffId], references: [id], onDelete: Restrict)

  @@unique([idempotencyKey])
  @@index([prescriptionId])
  @@index([prescriptionLineId])
  @@index([branchId, dispensedAt])
  @@map("dispense_events")
}

/// İlaç uygulama kaydı — ADMINISTERED. Hastaya fiilen uygulanan dozu tutar;
/// dağıtımdan (dispensed) bağımsızdır: klinikte veya sahipte uygulanan her doz
/// ayrı kayıt. Aşı uygulamaları VaccineEvent'tedir (lot+SKT zorunlu).
model AdministrationEvent {
  id                    String   @id @default(uuid()) @db.Uuid
  clinicId              String   @map("clinic_id") @db.Uuid
  branchId              String   @map("branch_id") @db.Uuid
  patientId             String   @map("patient_id") @db.Uuid
  prescriptionLineId    String?  @map("prescription_line_id") @db.Uuid
  encounterId           String?  @map("encounter_id") @db.Uuid
  productId             String?  @map("product_id") @db.Uuid
  drugName              String   @map("drug_name")
  doseGiven             Decimal? @map("dose_given") @db.Decimal(10, 3)
  doseUnit              String?  @map("dose_unit")
  route                 String?
  site                  String?
  administeredByStaffId String   @map("administered_by_staff_id") @db.Uuid
  administeredAt        DateTime @default(now()) @map("administered_at")
  note                  String?
  idempotencyKey        String?  @map("idempotency_key") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")

  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptionLine PrescriptionLine? @relation(fields: [prescriptionLineId], references: [id], onDelete: SetNull)
  product          Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  administeredBy   Staff             @relation(fields: [administeredByStaffId], references: [id], onDelete: Restrict)

  @@unique([idempotencyKey])
  @@index([patientId, administeredAt])
  @@index([branchId, administeredAt])
  @@map("administration_events")
}

/// Aşı protokolü — klinik kapsamlı ve düzenlenebilir (kabul kriteri 5): sabit
/// evrensel takvim yoktur; her klinik kendi protokolünü tür + ürün bazında
/// tanımlar. speciesId null = türden bağımsız protokol.
model VaccineProtocol {
  id                  String   @id @default(uuid()) @db.Uuid
  clinicId            String   @map("clinic_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  speciesId           String?  @map("species_id") @db.Uuid
  name                String
  /// İlk doz için önerilen yaş (gün) — hasta doğum tarihinden hesaplanır
  firstDoseAgeDays    Int      @default(0) @map("first_dose_age_days")
  /// Hatırlatıcı tekrar aralığı (gün) — örn. yıllık 365
  boosterIntervalDays Int      @default(365) @map("booster_interval_days")
  /// Aşı vadesinden kaç gün önce hatırlatma önerilir
  reminderLeadDays    Int      @default(14) @map("reminder_lead_days")
  doseLabel           String?  @map("dose_label")
  route               String?
  notes               String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  product Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  species Species? @relation(fields: [speciesId], references: [id], onDelete: SetNull)

  vaccineEvents VaccineEvent[]

  @@unique([clinicId, name])
  @@index([clinicId, active])
  @@index([productId])
  @@map("vaccine_protocols")
}

/// Aşı kaydı — uygulanan aşı; lot ve son kullanma tarihi kayıt anında partiden
/// dondurulur (kabul kriteri 4). Süresi geçmiş/karantinalı partiden aşı
/// uygulanamaz (409 LOT_EXPIRED / LOT_BLOCKED). Uygulama stoğu aynı işlemde
/// düşer (refType 'VaccineEvent' tüketim hareketi). nextDueAt protokolden
/// türetilir; protokol yoksa null kalır.
model VaccineEvent {
  id                    String    @id @default(uuid()) @db.Uuid
  clinicId              String    @map("clinic_id") @db.Uuid
  branchId              String    @map("branch_id") @db.Uuid
  patientId             String    @map("patient_id") @db.Uuid
  protocolId            String?   @map("protocol_id") @db.Uuid
  productId             String    @map("product_id") @db.Uuid
  warehouseId           String    @map("warehouse_id") @db.Uuid
  lotId                 String    @map("lot_id") @db.Uuid
  lotCode               String    @map("lot_code")
  expiresAt             DateTime? @map("expires_at")
  encounterId           String?   @map("encounter_id") @db.Uuid
  administeredByStaffId String    @map("administered_by_staff_id") @db.Uuid
  administeredAt        DateTime  @default(now()) @map("administered_at")
  doseLabel             String?   @map("dose_label")
  route                 String?
  site                  String?
  note                  String?
  nextDueAt             DateTime? @map("next_due_at")
  idempotencyKey        String?   @map("idempotency_key") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")

  clinic         Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  protocol       VaccineProtocol? @relation(fields: [protocolId], references: [id], onDelete: SetNull)
  product        Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lot            InventoryLot     @relation(fields: [lotId], references: [id], onDelete: Restrict)
  administeredBy Staff            @relation(fields: [administeredByStaffId], references: [id], onDelete: Restrict)

  reminders VaccineReminder[]

  @@unique([idempotencyKey])
  @@index([patientId, administeredAt])
  @@index([branchId, administeredAt])
  @@index([clinicId, productId])
  @@index([protocolId])
  @@map("vaccine_events")
}

/// Aşı hatırlatması — aynı aşı kaydı için aynı türde ikinci hatırlatma
/// benzersiz kısıtla engellenir (kabul kriteri 6); gönderim ikinci kez
/// istenirse 409 döner. Gönderim kanalı Faz 12 bildirim entegrasyonuna
/// hazırdır (şimdilik kayıt + denetim yazımı). status: 'scheduled' | 'sent' |
/// 'dismissed'.
model VaccineReminder {
  id             String    @id @default(uuid()) @db.Uuid
  clinicId       String    @map("clinic_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  vaccineEventId String?   @map("vaccine_event_id") @db.Uuid
  productId      String?   @map("product_id") @db.Uuid
  /// 'booster_due' | 'first_dose' | 'custom'
  kind           String    @default("booster_due")
  dueAt          DateTime  @map("due_at") @db.Date
  status         String    @default("scheduled")
  channel        String?
  sentAt         DateTime? @map("sent_at")
  sentByStaffId  String?   @map("sent_by_staff_id") @db.Uuid
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  vaccineEvent VaccineEvent? @relation(fields: [vaccineEventId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sentBy       Staff?        @relation(fields: [sentByStaffId], references: [id], onDelete: SetNull)
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  /// Aynı aşı kaydına aynı türden ikinci hatırlatma yazılamaz (NULL vaccineEventId
  /// satırları PG'de tekil kısıta takılmaz — serbest hatırlatmalar için bilinir)
  @@unique([vaccineEventId, kind])
  @@index([clinicId, status, dueAt])
  @@index([patientId])
  @@map("vaccine_reminders")
}

/// ============================================================================
/// Faz 11 — Laboratuvar, cerrahi ve yatış modülleri
/// ============================================================================

/// Lab test kataloğu — klinik kapsamlı; referans/kritik aralıklar test başına.
/// Türe özgü aralık gerekiyorsa aynı test türe bağlı ikinci satır olarak açılır.
model LabCatalog {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @map("clinic_id") @db.Uuid
  code            String
  name            String
  /// 'kan' | 'idrar' | 'dışkı' | 'swab' | 'doku' | 'diğer'
  sampleType      String   @map("sample_type")
  unit            String?
  speciesId       String?  @map("species_id") @db.Uuid
  /// Referans aralık (opsiyonel — kalitatif testlerde boş)
  refLow          Decimal? @map("ref_low") @db.Decimal(10, 2)
  refHigh         Decimal? @map("ref_high") @db.Decimal(10, 2)
  /// Kritik eşikler — dışına düşen sonuç klinisyen uyarısı üretir
  criticalLow     Decimal? @map("critical_low") @db.Decimal(10, 2)
  criticalHigh    Decimal? @map("critical_high") @db.Decimal(10, 2)
  turnaroundHours Int      @default(24) @map("turnaround_hours")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  clinic  Clinic      @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  species Species?    @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  orders  LabOrder[]
  results LabResult[]

  @@unique([clinicId, code])
  @@index([clinicId, active])
  @@map("lab_catalog")
}

/// Lab sipariş yaşam döngüsü: ordered → sample_collected → in_progress → completed
/// (her aktif durumdan cancelled olabilir; terminal durumlar geçişe kapalıdır).
model LabOrder {
  id             String    @id @default(uuid()) @db.Uuid
  clinicId       String    @map("clinic_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  encounterId    String?   @map("encounter_id") @db.Uuid
  testId         String    @map("test_id") @db.Uuid
  /// 'ordered' | 'sample_collected' | 'in_progress' | 'completed' | 'cancelled'
  status         String    @default("ordered")
  /// 'routine' | 'urgent'
  priority       String    @default("routine")
  /// Sonuç uyarısının gittiği yetkili klinisyen
  veterinarianId String    @map("veterinarian_id") @db.Uuid
  requestedById  String    @map("requested_by_id") @db.Uuid
  cancelledById  String?   @map("cancelled_by_id") @db.Uuid
  cancelReason   String?
  notes          String?
  orderedAt      DateTime  @default(now()) @map("ordered_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter      Encounter?      @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  test           LabCatalog      @relation(fields: [testId], references: [id], onDelete: Restrict)
  veterinarian   Staff           @relation("LabOrderVeterinarian", fields: [veterinarianId], references: [id], onDelete: Restrict)
  requestedBy    Staff           @relation("LabOrderRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  cancelledBy    Staff?          @relation("LabOrderCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  samples        Sample[]
  results        LabResult[]
  printDocuments PrintDocument[]

  @@index([clinicId, status, orderedAt])
  @@index([branchId, status])
  @@index([patientId])
  @@index([encounterId])
  @@map("lab_orders")
}

/// Numune — sipariş başına tek kayıt; toplandıktan sonra durum güncellenir.
model Sample {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @map("clinic_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  sampleType      String   @map("sample_type")
  /// Etiket/barkod kodu (LAB-YYMMDD-XXXX)
  labelCode       String   @map("label_code")
  /// 'collected' | 'rejected'
  status          String   @default("collected")
  rejectionReason String?  @map("rejection_reason")
  collectedAt     DateTime @default(now()) @map("collected_at")
  collectedById   String   @map("collected_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  order       LabOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  collectedBy Staff    @relation("SampleCollector", fields: [collectedById], references: [id], onDelete: Restrict)

  @@unique([orderId])
  @@index([clinicId, status])
  @@map("lab_samples")
}

/// Sonuç — sipariş başına tek sonuç; kritik tespit kayım anında dondurulur.
model LabResult {
  id               String    @id @default(uuid()) @db.Uuid
  clinicId         String    @map("clinic_id") @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  testId           String    @map("test_id") @db.Uuid
  /// Sayısal sonuç; kalitatif testlerde boş
  value            Decimal?  @db.Decimal(12, 2)
  /// Kalitatif/pozitif sonuç metni
  valueText        String?   @map("value_text")
  unit             String?
  /// Katalogdan kopyalanan referans aralığı anlık görüntüsü
  refLow           Decimal?  @map("ref_low") @db.Decimal(10, 2)
  refHigh          Decimal?  @map("ref_high") @db.Decimal(10, 2)
  /// 'normal' | 'low' | 'high' | 'critical_low' | 'critical_high' | 'abnormal'
  flag             String
  isCritical       Boolean   @default(false) @map("is_critical")
  acknowledgedAt   DateTime? @map("acknowledged_at")
  acknowledgedById String?   @map("acknowledged_by_id") @db.Uuid
  notes            String?
  resultedAt       DateTime  @default(now()) @map("resulted_at")
  resultedById     String    @map("resulted_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  order          LabOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test           LabCatalog @relation(fields: [testId], references: [id], onDelete: Restrict)
  resultedBy     Staff      @relation("LabResultReporter", fields: [resultedById], references: [id], onDelete: Restrict)
  acknowledgedBy Staff?     @relation("LabResultAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@unique([orderId])
  @@index([clinicId, isCritical, acknowledgedAt])
  @@index([testId])
  @@map("lab_results")
}

/// Cerrahi olgu — encounter/patient/vet bağlantılı planlama ve yürütme.
model SurgeryCase {
  id                 String    @id @default(uuid()) @db.Uuid
  clinicId           String    @map("clinic_id") @db.Uuid
  branchId           String    @map("branch_id") @db.Uuid
  patientId          String    @map("patient_id") @db.Uuid
  ownerId            String    @map("owner_id") @db.Uuid
  encounterId        String?   @map("encounter_id") @db.Uuid
  veterinarianId     String    @map("veterinarian_id") @db.Uuid
  roomId             String?   @map("room_id") @db.Uuid
  /// 'planned' | 'prepped' | 'in_surgery' | 'recovery' | 'completed' | 'cancelled'
  status             String    @default("planned")
  procedure          String
  diagnosis          String?
  plannedStart       DateTime  @map("planned_start")
  plannedDurationMin Int       @default(60) @map("planned_duration_min")
  actualStart        DateTime? @map("actual_start")
  actualEnd          DateTime? @map("actual_end")
  cancelReason       String?
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  clinic       Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  owner        Owner              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  encounter    Encounter?         @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  veterinarian Staff              @relation("SurgeryVeterinarian", fields: [veterinarianId], references: [id], onDelete: Restrict)
  room         Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  anesthesia   AnesthesiaRecord?
  checklists   SurgeryChecklist[]

  @@index([branchId, status, plannedStart])
  @@index([patientId])
  @@index([veterinarianId, plannedStart])
  @@map("surgery_cases")
}

/// Anestezi çizelgesi — her cerrahi olguda tek kayıt (unique).
model AnesthesiaRecord {
  id               String    @id @default(uuid()) @db.Uuid
  clinicId         String    @map("clinic_id") @db.Uuid
  surgeryCaseId    String    @unique @map("surgery_case_id") @db.Uuid
  /// ASA fiziksel durum sınıfı: 'I' | 'II' | 'III' | 'IV' | 'V'
  asaClass         String?   @map("asa_class")
  weightKg         Decimal?  @map("weight_kg") @db.Decimal(6, 2)
  premedication    String?
  inductionAgent   String?   @map("induction_agent")
  maintenanceAgent String?   @map("maintenance_agent")
  monitoringNotes  String?   @map("monitoring_notes")
  anesthetistId    String?   @map("anesthetist_id") @db.Uuid
  startedAt        DateTime? @map("started_at")
  endedAt          DateTime? @map("ended_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  surgeryCase SurgeryCase @relation(fields: [surgeryCaseId], references: [id], onDelete: Cascade)
  anesthetist Staff?      @relation("AnesthesiaAnesthetist", fields: [anesthetistId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@map("anesthesia_records")
}

/// Cerrahi kontrol listesi — olgu başına 'pre' ve 'post' tek kayıt; maddeler JSON.
model SurgeryChecklist {
  id            String   @id @default(uuid()) @db.Uuid
  clinicId      String   @map("clinic_id") @db.Uuid
  surgeryCaseId String   @map("surgery_case_id") @db.Uuid
  /// 'pre' | 'post'
  kind          String
  /// [{ label, done, doneAt?, doneById? }]
  items         Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  surgeryCase SurgeryCase @relation(fields: [surgeryCaseId], references: [id], onDelete: Cascade)

  @@unique([surgeryCaseId, kind])
  @@map("surgery_checklists")
}

/// Kennel (kafes/kümes) — şube kapsamlı; yatış çakışması kontrolü kaynağı.
model Kennel {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  code      String
  name      String
  /// 'small' | 'medium' | 'large'
  size      String   @default("medium")
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  stays  HospitalStay[]

  @@unique([branchId, code])
  @@index([branchId, active])
  @@map("kennels")
}

/// Yatış — kabul/transfer/taburculuk tarihli; aktif yatış kennel işgal eder.
model HospitalStay {
  id                  String    @id @default(uuid()) @db.Uuid
  clinicId            String    @map("clinic_id") @db.Uuid
  branchId            String    @map("branch_id") @db.Uuid
  patientId           String    @map("patient_id") @db.Uuid
  ownerId             String    @map("owner_id") @db.Uuid
  encounterId         String?   @map("encounter_id") @db.Uuid
  kennelId            String    @map("kennel_id") @db.Uuid
  veterinarianId      String    @map("veterinarian_id") @db.Uuid
  /// 'admitted' | 'transferred' | 'discharged'
  status              String    @default("admitted")
  admissionReason     String    @map("admission_reason")
  admittedAt          DateTime  @default(now()) @map("admitted_at")
  transferredAt       DateTime? @map("transferred_at")
  expectedDischargeAt DateTime? @map("expected_discharge_at")
  dischargedAt        DateTime? @map("discharged_at")
  dischargeSummary    String?   @map("discharge_summary")
  createdById         String?   @map("created_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  clinic         Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch         Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient        Patient                    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  owner          Owner                      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  encounter      Encounter?                 @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  kennel         Kennel                     @relation(fields: [kennelId], references: [id], onDelete: Restrict)
  veterinarian   Staff                      @relation("HospitalStayVeterinarian", fields: [veterinarianId], references: [id], onDelete: Restrict)
  observations   HospitalObservation[]
  medications    MedicationAdministration[]
  printDocuments PrintDocument[]

  @@index([branchId, status, admittedAt])
  @@index([kennelId, status])
  @@index([patientId])
  @@map("hospital_stays")
}

/// Yatış gözlemi — günlük vital takip ve notlar; tüm geçmiş korunur.
model HospitalObservation {
  id           String   @id @default(uuid()) @db.Uuid
  clinicId     String   @map("clinic_id") @db.Uuid
  stayId       String   @map("stay_id") @db.Uuid
  /// 'vital' | 'note'
  kind         String   @default("vital")
  tempC        Decimal? @map("temp_c") @db.Decimal(4, 1)
  weightKg     Decimal? @map("weight_kg") @db.Decimal(6, 2)
  heartRate    Int?     @map("heart_rate")
  respRate     Int?     @map("resp_rate")
  appetite     String?
  behavior     String?
  notes        String?
  observedAt   DateTime @default(now()) @map("observed_at")
  observedById String   @map("observed_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  stay       HospitalStay @relation(fields: [stayId], references: [id], onDelete: Cascade)
  observedBy Staff        @relation("HospitalObserver", fields: [observedById], references: [id], onDelete: Restrict)

  @@index([stayId, observedAt])
  @@index([clinicId])
  @@map("hospital_observations")
}

/// Yatış içi ilaç/ürün uygulaması — stok düşümü Faz 08 ortak transaction
/// servisiyle (StockService.postConsumptionForRef, refType=HospitalMedication)
/// yapılır; modül kendi stok mantığını yazmaz.
model MedicationAdministration {
  id               String   @id @default(uuid()) @db.Uuid
  clinicId         String   @map("clinic_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  stayId           String   @map("stay_id") @db.Uuid
  patientId        String   @map("patient_id") @db.Uuid
  productId        String?  @map("product_id") @db.Uuid
  serviceId        String?  @map("service_id") @db.Uuid
  warehouseId      String?  @map("warehouse_id") @db.Uuid
  qty              Decimal  @db.Decimal(12, 3)
  lotId            String?  @db.Uuid
  dose             String?
  route            String?
  administeredAt   DateTime @default(now()) @map("administered_at")
  administeredById String   @map("administered_by_id") @db.Uuid
  stockMovementId  String?  @map("stock_movement_id") @db.Uuid
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  stay           HospitalStay   @relation(fields: [stayId], references: [id], onDelete: Cascade)
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  product        Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  service        Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  administeredBy Staff          @relation("MedicationAdministerer", fields: [administeredById], references: [id], onDelete: Restrict)
  stockMovement  StockMovement? @relation("MedicationStockMovement", fields: [stockMovementId], references: [id], onDelete: SetNull)

  @@index([stayId, administeredAt])
  @@index([clinicId, administeredAt])
  @@index([productId])
  @@map("medication_administrations")
}

/// Bildirim şablonu — kanal bazlı, {{degisken}} yer tutucularıyla. Şablon metni
/// render anında değişkenlerle doldurulur; eksik zorunlu değişken render'ı 400 yapar.
model NotificationTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  /// Klinik içinde tekil şablon kodu (ör. APPT_REMINDER_SMS)
  code      String
  name      String
  /// 'push' | 'sms' | 'email' | 'whatsapp'
  channel   String
  /// 'appointment' | 'vaccine' | 'lab' | 'hospital' | 'custom'
  category  String
  /// E-posta konusu; SMS/WhatsApp/push için null
  subject   String?
  /// Gövde şablonu — {{ownerName}}, {{patientName}}, {{date}}, {{time}}...
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@unique([clinicId, code])
  @@index([clinicId, channel])
  @@map("notification_templates")
}

/// Bildirim — iç bildirim merkezi kaydı. Kuyruk satırıdır: queued→processing→
/// sent | failed | dead_letter | skipped. Onay (consent) kuralı kuyruğa girişte
/// zorlanır; gönderim denemeleri NotificationAttempt'te izlenir.
model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  clinicId       String    @map("clinic_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  templateId     String?   @map("template_id") @db.Uuid
  /// 'push' | 'sms' | 'email' | 'whatsapp'
  channel        String
  /// 'appointment' | 'vaccine' | 'lab' | 'hospital' | 'custom'
  category       String
  ownerId        String    @map("owner_id") @db.Uuid
  /// Normalleştirilmiş alıcı (telefon 90..., e-posta küçük harf)
  recipientValue String    @map("recipient_value")
  subject        String?
  body           String
  /// 'queued' | 'processing' | 'sent' | 'failed' | 'dead_letter' | 'skipped'
  status         String    @default("queued")
  /// Atlanma gerekçesi (CONSENT_MISSING gibi) — status=skipped için
  skipReason     String?   @map("skip_reason")
  /// Üretilen uyarı: FAILED_PROVIDER vs. — status=failed için
  lastError      String?   @map("last_error")
  /// Deneme sayacı (attempt kayıtlarıyla senkron)
  attempts       Int       @default(0)
  /// Kuyruk tekilleştirme anahtarı — aynı anahtar ikinci kez kuyruğa girmez
  /// (retry duplicate kabul kriterinin DB düzeyi güvencesi)
  idempotencyKey String    @map("idempotency_key")
  scheduledFor   DateTime  @default(now()) @map("scheduled_for")
  sentAt         DateTime? @map("sent_at")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  clinic     Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch     Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  template   NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  owner      Owner                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy  Staff?                @relation("NotificationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attemptLog NotificationAttempt[]

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, status])
  @@index([clinicId, ownerId])
  @@index([branchId, status])
  @@index([scheduledFor, status])
  @@map("notifications")
}

/// Gönderim denemesi — her kuyruk işleme adımının sonucu. (notificationId,
/// attemptNo) tekil; providerMessageId sandık sağlayıcıdan döner ve aynı
/// bildirimin tüm denemelerinde aynıdır (duplicate gönderim kanıtı için).
model NotificationAttempt {
  id                String   @id @default(uuid()) @db.Uuid
  notificationId    String   @map("notification_id") @db.Uuid
  attemptNo         Int      @map("attempt_no")
  /// 'success' | 'retryable' | 'permanent'
  outcome           String
  providerName      String   @map("provider_name")
  providerMessageId String?  @map("provider_message_id")
  error             String?
  startedAt         DateTime @map("started_at")
  finishedAt        DateTime @map("finished_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, attemptNo])
  @@index([notificationId])
  @@map("notification_attempts")
}

/// Entegrasyon bağlantısı — yalnızca bağlantı üst verisi. Provider secret
/// ASLA bu tabloya yazılmaz: kimlik bilgileri yalnızca sunucu tarafı env'den
/// okunur (kabul kriteri). mode='live' yalnız yetkili sözleşmeyle açılır.
model IntegrationConnection {
  id              String    @id @default(uuid()) @db.Uuid
  clinicId        String    @map("clinic_id") @db.Uuid
  /// 'einvoice' | 'lab'
  kind            String
  /// Sağlayıcı adı (ör. sandbox stub: 'vetcore-sandbox')
  providerName    String    @map("provider_name")
  /// 'sandbox' | 'live'
  mode            String    @default("sandbox")
  /// 'active' | 'inactive'
  status          String    @default("inactive")
  /// Secret içermeyen yapılandırma (endpoint, org kodu vb.); secret anahtar
  /// adları yazım anında reddedilir (SECRET_NOT_ALLOWED).
  config          Json?
  lastCheckAt     DateTime? @map("last_check_at")
  lastCheckResult String?   @map("last_check_result")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@unique([clinicId, kind])
  @@index([clinicId])
  @@map("integration_connections")
}

/// Yazdırılabilir belge — üretim anında dondurulmuş anlık görüntü (snapshot)
/// + private storage'daki PDF. Kaynak kayıt sonradan değişse de belge değişmez
/// (muayene özeti, aşı kartı, reçete, onam, lab raporu, taburculuk).
model PrintDocument {
  id             String   @id @default(uuid()) @db.Uuid
  clinicId       String   @map("clinic_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  /// 'exam_summary' | 'vaccine_card' | 'prescription' | 'consent' | 'lab_report' | 'discharge'
  kind           String
  /// Klinik içinde tekil belge numarası (BELGE-0001; kayım sırası transaction ile)
  documentNo     String   @map("document_no")
  title          String
  patientId      String?  @map("patient_id") @db.Uuid
  ownerId        String?  @map("owner_id") @db.Uuid
  encounterId    String?  @map("encounter_id") @db.Uuid
  prescriptionId String?  @map("prescription_id") @db.Uuid
  labOrderId     String?  @map("lab_order_id") @db.Uuid
  hospitalStayId String?  @map("hospital_stay_id") @db.Uuid
  /// Üretim anındaki kaynak veri anlık görüntüsü (denetlenebilir çıktı)
  snapshot       Json
  /// Private storage anahtarı — dış URL verilmez, indirme API ucuyladır
  storageKey     String   @map("storage_key")
  fileMime       String   @default("application/pdf") @map("file_mime")
  fileSize       Int      @map("file_size")
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  owner        Owner?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  encounter    Encounter?    @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  labOrder     LabOrder?     @relation(fields: [labOrderId], references: [id], onDelete: SetNull)
  hospitalStay HospitalStay? @relation(fields: [hospitalStayId], references: [id], onDelete: SetNull)
  createdBy    Staff         @relation("PrintDocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([clinicId, documentNo])
  @@index([clinicId, kind, createdAt])
  @@index([branchId, createdAt])
  @@index([patientId])
  @@map("print_documents")
}

/// Faz 13 — mobil çevrimdışı senkronizasyon işlem kaydı (outbox defteri).
/// Her istemci işlemi client_operation_id ile tekilleşir: aynı anahtar REPLAY
/// döner ve yanıt kayıttan oynatılır — tekrar deneme duplicate ücret/stok/
/// hizmet üretmez. Sonuç (accepted/rejected/conflict) + dönen sunucu anlık
/// görüntüsü saklanır; çakışma çözümü istemci tarafında iki versiyonla yapılır.
model SyncOperation {
  id                 String   @id @default(uuid()) @db.Uuid
  clinicId           String   @map("clinic_id") @db.Uuid
  branchId           String   @map("branch_id") @db.Uuid
  /// İşlemi gönderen cihaz/personel — denetim ve şube kapsamı kaynağı
  staffId            String   @map("staff_id") @db.Uuid
  /// İstemci üretimi tekil anahtar (UUIDv4) — @@unique ile REPLAY garantisidir
  clientOperationId  String   @map("client_operation_id")
  /// Beyaz liste: 'encounter.create_draft' | 'encounter.update_draft' |
  /// 'appointment.check_in' | 'appointment.status' | 'appointment.cancel'
  /// finalize/finance/stock türleri BURADA YOK — sunucu onayı olmadan posted
  /// görünemez (kabul kriteri) ve push yoluyla asla kesinleşmez.
  kind               String
  /// Hedef varlık türü: 'encounter' | 'appointment'
  entity             String
  entityId           String?  @map("entity_id") @db.Uuid
  /// İstemcinin gördüğü sürüm — sunucudaki sürümden geri ise CONFLICT.
  /// Kodlama: encounter → int version metni ("3"); appointment → updatedAt
  /// epoch ms ("1731050000123"); create_draft → "0".
  expectedVersion    String   @default("0") @map("expected_version")
  /// Uygulama anındaki istek gövdesi (denetim + replay kaynağı)
  payload            Json
  /// 'accepted' | 'rejected' | 'conflict' — accepted replay sonucu da accepted
  status             String
  /// Uygulama sonucu: serverId, version, snapshot (accepted) ya da hata kodu
  result             Json
  createdAt          DateTime @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([clinicId, clientOperationId])
  @@index([clinicId, branchId, createdAt])
  @@index([clinicId, staffId, createdAt])
  @@map("sync_operations")
}
